@dataclass
class RItem:            # remote entry
    path: str           # logical path (gdocs: "Plan.gdoc")
    kind: str           # file | dir | gdoc
    size: int
    mtime: str
    hash: str
    id: str
    rname: str          # path on the remote (gdocs: "Plan.desktop")
    gtype: str = ""
    owner: str = ""     # owner's email (from -M metadata; empty in Shared drives)


@dataclass
class LItem:            # local entry
    path: str
    kind: str           # real | stub | link
    fpath: Path
    size: int = 0
    mtime: float = 0.0
    xid: str = ""
    orig: str = ""      # placeholders: the path they were created at (move detection)


@dataclass
class Row:              # last-synced state (the "base" of the 3-way merge)
    path: str
    kind: str           # file | dir | gdoc
    state: str          # local | cloud | gdoc | dir
    rid: str = ""
    rsize: int = 0
    rmtime: str = ""
    rhash: str = ""
    lsize: int = 0
    lmtime: float = 0.0
    rname: str = ""

    def as_ritem(self) -> RItem:
        return RItem(self.path, self.kind, self.rsize, self.rmtime, self.rhash, self.rid, self.rname)


class RowMap(dict):
    """path -> Row that remembers which paths changed, so the DB is updated incrementally."""

    def __init__(self, *args, **kw):
        super().__init__(*args, **kw)
        self.dirty: set[str] = set()

    def __setitem__(self, k, v):
        if dict.get(self, k) != v:
            self.dirty.add(k)
        super().__setitem__(k, v)

    def __delitem__(self, k):
        super().__delitem__(k)
        self.dirty.add(k)

    def pop(self, k, *default):
        if k in self:
            self.dirty.add(k)
        return super().pop(k, *default)

    def update(self, *args, **kw):
        for k, v in dict(*args, **kw).items():
            self[k] = v


@dataclass
class Scope:
    """Part of the tree a sync reconciles: the direct children of `flat` folders and everything
    below `deep` folders. A full sync is Scope(deep={""})."""
    flat: set = field(default_factory=set)
    deep: set = field(default_factory=set)
    busy: frozenset = frozenset()               # entries left alone this time (see Engine.sync)

    def contains(self, p: str) -> bool:         # is entry p (file or folder) reconciled?
        return p != "" and p not in self.busy and \
            (parent(p) in self.flat or any(p != d and under(p, d) for d in self.deep))

    def is_deep(self, d: str) -> bool:          # is the whole subtree of folder d in scope?
        return any(under(d, x) for x in self.deep)

    def covers(self, d: str) -> bool:           # are all children of folder d in scope?
        return d in self.flat or self.is_deep(d)


class ScopeTooBig(Exception):
    """A targeted sync would touch too many folders; a full sync is cheaper."""


class DB:
    SCHEMA = 1      # PRAGMA user_version.  0: files+pins (v0.1)  1: + meta

    def __init__(self, path: Path):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.c = sqlite3.connect(path)
        self.c.execute("CREATE TABLE IF NOT EXISTS files(path TEXT PRIMARY KEY, kind TEXT, state TEXT,"
                       " rid TEXT, rsize INT, rmtime TEXT, rhash TEXT, lsize INT, lmtime REAL, rname TEXT)")
        self.c.execute("CREATE TABLE IF NOT EXISTS pins(path TEXT PRIMARY KEY)")
        self._migrate()
        self._seen = self._data_version()

    def _migrate(self):
        v = self.c.execute("PRAGMA user_version").fetchone()[0]
        if v < 1:       # small key/value store: Drive changes page token, ...
            self.c.execute("CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT)")
            self.c.execute("PRAGMA user_version = 1")
        self.c.commit()

    def _data_version(self) -> int:
        return self.c.execute("PRAGMA data_version").fetchone()[0]

    def changed(self) -> bool:
        """True if another process (CLI pin/unpin/sync) committed since the last call."""
        v = self._data_version()
        changed, self._seen = v != self._seen, v
        return changed

    def load(self) -> RowMap:
        return RowMap({r[0]: Row(*r) for r in self.c.execute(
            "SELECT path,kind,state,rid,rsize,rmtime,rhash,lsize,lmtime,rname FROM files")})

    def save(self, S: dict[str, Row]):
        if not isinstance(S, RowMap):
            return self.save_all(S)
        if not S.dirty:
            return
        gone = [(k,) for k in S.dirty if k not in S]
        rows = [astuple(S[k]) for k in S.dirty if k in S]
        with self.c:
            self.c.executemany("DELETE FROM files WHERE path=?", gone)
            self.c.executemany("INSERT OR REPLACE INTO files VALUES (?,?,?,?,?,?,?,?,?,?)", rows)
        S.dirty.clear()

    def save_all(self, S: dict[str, Row]):
        with self.c:
            self.c.execute("DELETE FROM files")
            self.c.executemany("INSERT INTO files VALUES (?,?,?,?,?,?,?,?,?,?)",
                               [astuple(r) for r in S.values()])
        if isinstance(S, RowMap):
            S.dirty.clear()

    def pins(self) -> set[str]:
        return {r[0] for r in self.c.execute("SELECT path FROM pins")}

    def add_pin(self, p: str):
        with self.c:
            self.c.execute("INSERT OR IGNORE INTO pins VALUES (?)", (p,))

    def remove_pins_under(self, p: str):
        with self.c:
            for q in self.pins():
                if under(q, p):
                    self.c.execute("DELETE FROM pins WHERE path=?", (q,))

    def move_pins(self, old: str, new: str):
        with self.c:
            for q in self.pins():
                if under(q, old):
                    self.c.execute("UPDATE OR REPLACE pins SET path=? WHERE path=?", (new + q[len(old):], q))

    def get_meta(self, key: str, default: str | None = None) -> str | None:
        r = self.c.execute("SELECT value FROM meta WHERE key=?", (key,)).fetchone()
        return r[0] if r else default

    def set_meta(self, key: str, value: str):
        with self.c:
            self.c.execute("INSERT OR REPLACE INTO meta VALUES (?,?)", (key, value))

    def close(self):
        self.c.close()


def parse_ritem(e: dict) -> RItem | None:
    rname = e["Path"]
    rid = e.get("ID", "") or ""
    mtime = e.get("ModTime", "")
    md = e.get("Metadata") or {}
    owner = md.get("owner", "") or ""
    if e.get("IsDir"):
        return RItem(rname, "dir", 0, mtime, "", rid, rname, owner=owner)
    ct = md.get("content-type") or e.get("MimeType") or ""
    h = (e.get("Hashes") or {}).get("md5", "") or ""
    gtype = ""
    if ct.startswith("application/vnd.google-apps."):
        gtype = ct.rsplit(".", 1)[1]
    elif rid and rname.endswith(".desktop") and not h:
        gtype = "unknown"
    if gtype:
        base = rname[:-len(".desktop")] if rname.endswith(".desktop") else rname
        return RItem(base + GTYPE_EXT.get(gtype, ".glink"), "gdoc", 0, mtime, "", rid, rname, gtype, owner)
    return RItem(rname, "file", int(e.get("Size", 0) or 0), mtime, h, rid, rname, owner=owner)


# ───────────────────────────── engine ─────────────────────────────
class Engine:
    MAX_SCOPE = 64      # folders listed by one targeted sync; beyond that a full sync is cheaper

    def __init__(self, acc: Account, db: DB, S: dict[str, Row] | None = None):
        self.acc, self.db = acc, db
        self.S = S if S is not None else db.load()
        self.pins = db.pins()
        self.dupe_stubs: list[Path] = []
        self.deferred: dict[str, float] = {}    # files skipped while still being written -> seconds left
        self.cancelled = lambda: False          # set by the daemon: stop between steps on shutdown
        self.on_event = lambda kind, path: None # set by the daemon: activity for gdrive-od-ui
        try:                                    # path -> version Drive refused ([size, mtime] or ["dir"])
            self.denied: dict[str, list] = json.loads(db.get_meta("denied") or "{}")
        except ValueError:
            self.denied = {}
        self.restored: list[str] = []           # this run: deletions undone (not yours / not allowed)
        self.refused: list[str] = []            # this run: local items Drive wouldn't take

    # paths
    def real_path(self, p: str) -> Path:
        return self.acc.local / p

    def stub_path(self, p: str) -> Path:
        return self.acc.local / (p + STUB_EXT)

    def pinned(self, p: str) -> bool:
        return any(under(p, pin) for pin in self.pins)

    # ── remote / local listings
    def list_remote(self, sub: str = "", recursive: bool = True) -> dict[str, RItem]:
        """Remote entries below folder `sub`: all levels, or only its direct children."""
        flags = ["-R", "--fast-list"] if recursive else []
        out = rclone(self.acc, "lsjson", *flags, *LIST_FLAGS, self.acc.rpath(sub))
        items = {}
        for e in json.loads(out or "[]"):
            e["Path"] = join(sub, e["Path"])
            r = parse_ritem(e)
            if r and not ignored_name(os.path.basename(r.path)) and not r.path.endswith(STUB_EXT) \
                    and not self.excluded(r.path):
                items[r.path] = r
        return items

    def excluded(self, p: str) -> bool:
        return any(under(p, x) for x in self.acc.exclude)

    def stat_remote(self, rname: str) -> RItem:
        e = json.loads(rclone(self.acc, "lsjson", "--stat", *LIST_FLAGS, self.acc.rpath(rname)))
        e["Path"] = rname
        return parse_ritem(e)

    def scan_local(self, sub: str = "", recursive: bool = True):
        """Local entries below folder `sub` -> (items, folders, folder exists)."""
        root = self.acc.local
        root.mkdir(parents=True, exist_ok=True)
        items: dict[str, LItem] = {}
        dirs: set[str] = set()
        top = root / sub if sub else root
        if sub and (top.is_symlink() or not top.is_dir()):
            return items, dirs, False
        for dirpath, dirnames, filenames in os.walk(top):
            rel_dir = os.path.relpath(dirpath, root)
            rel_dir = "" if rel_dir == "." else rel_dir
            dirnames[:] = [d for d in dirnames if not ignored_name(d) and not self.excluded(join(rel_dir, d))
                           and not os.path.islink(os.path.join(dirpath, d))]
            for d in dirnames:
                dirs.add(join(rel_dir, d))
            if not recursive:
                dirnames[:] = []
            for fn in filenames:
                if ignored_name(fn):
                    continue
                fp = Path(dirpath) / fn
                try:
                    st = fp.lstat()
                except FileNotFoundError:
                    continue
                if not stat.S_ISREG(st.st_mode):
                    continue
                rel = join(rel_dir, fn)
                if self.excluded(rel):
                    continue
                if fn.endswith(STUB_EXT):
                    logical = rel[:-len(STUB_EXT)]
                    if logical in items and items[logical].kind == "real":
                        self.dupe_stubs.append(fp)
                        continue
                    items[logical] = LItem(logical, "stub", fp, st.st_size, st.st_mtime, *self._stub_meta(fp))
                elif Path(fn).suffix in LINK_EXTS and (lid := self._link_id(fp, st)) is not None:
                    items[rel] = LItem(rel, "link", fp, st.st_size, st.st_mtime, lid)
                else:
                    if rel in items and items[rel].kind == "stub":
                        self.dupe_stubs.append(items[rel].fpath)
                    items[rel] = LItem(rel, "real", fp, st.st_size, st.st_mtime)
        return items, dirs, True

    def _scan_scope(self, scope: Scope):
        L: dict[str, LItem] = {}
        Ld: set[str] = set()
        for d in scope.flat:
            if not scope.is_deep(d):
                items, dirs, _ = self.scan_local(d, recursive=False)
                L.update(items)
                Ld |= dirs
        for d in scope.deep:
            if not any(x != d and under(d, x) for x in scope.deep):
                items, dirs, _ = self.scan_local(d, recursive=True)
                L.update(items)
                Ld |= dirs
        return L, Ld

    def _gather(self, dirs) -> tuple[Scope, dict, dict, set]:
        """Listings for a targeted sync of the direct children of `dirs`. A folder missing on
        either side widens the scope to its parent; a subfolder that is new, gone or one-sided
        is taken with its whole subtree; the old folder of anything that moved here (same
        Drive ID) is brought in too, so moves are recognised as moves."""
        S = self.S
        sc = Scope()
        R: dict[str, RItem] = {}
        L: dict[str, LItem] = {}
        Ld: set[str] = set()
        Sd = {p for p, r in S.items() if r.kind == "dir"}
        skids: dict[str, set] = {}
        by_rid: dict[str, list] = {}
        for p, row in S.items():
            if row.kind == "dir":
                skids.setdefault(parent(p), set()).add(p)
            if row.rid:
                by_rid.setdefault(row.rid, []).append(p)

        def grow():
            if len(sc.flat) + len(sc.deep) >= self.MAX_SCOPE:
                raise ScopeTooBig()

        todo = set(dirs)
        while todo:
            d = min(todo, key=lambda x: (x.count("/"), x))      # shallow first: deep scopes cover the rest
            todo.discard(d)
            if sc.covers(d):
                continue
            grow()
            sc.flat.add(d)
            try:
                got_r = self.list_remote(d, recursive=False)
            except RcloneError as e:
                if e.code != DIR_NOT_FOUND:
                    raise
                got_r = None
            got_l, got_ld, l_ok = self.scan_local(d, recursive=False)
            if got_r is None and not d:
                raise RuntimeError(f"{self.acc.remote} was not found online — refusing to sync")
            if d and (got_r is None or not l_ok):
                todo.add(parent(d))
            got_r = got_r or {}
            R.update(got_r)
            L.update(got_l)
            Ld |= got_ld
            found: list = [*got_r.values(), *got_l.values()]
            for c in sorted({p for p, r in got_r.items() if r.kind == "dir"} | got_ld | skids.get(d, set())):
                in_r = c in R and R[c].kind == "dir"
                if sc.is_deep(c) or (in_r and c in Ld and c in Sd):
                    continue
                grow()
                sc.deep.add(c)
                if in_r:
                    sub = self.list_remote(c, recursive=True)
                    R.update(sub)
                    found += sub.values()
                if c in Ld:
                    items, ldirs, _ = self.scan_local(c, recursive=True)
                    L.update(items)
                    Ld |= ldirs
                    found += items.values()
            for x in found:
                xid = x.id if isinstance(x, RItem) else (x.xid if x.kind in ("stub", "link") else "")
                for old in by_rid.get(xid, ()) if xid else ():
                    if old != x.path and not sc.contains(old):
                        todo.add(parent(old))
        return sc, R, L, Ld

    @staticmethod
    def _stub_meta(fp: Path) -> tuple[str, str]:
        xid, orig = getx(fp, "user.gdrive.id"), getx(fp, "user.gdrive.path")
        if not (xid and orig):
            try:
                for line in fp.read_text(errors="ignore").splitlines():
                    if line.startswith("id: ") and not xid:
                        xid = line[4:].strip()
                    elif line.startswith("path: ") and not orig:
                        orig = line[6:].strip()
            except OSError:
                pass
        return xid, orig

    @staticmethod
    def _link_id(fp: Path, st) -> str | None:
        if st.st_size > 4096:
            return None
        try:
            d = json.loads(fp.read_text())
            return d.get("id", "") if d.get("gdrive_od") else None
        except Exception:
            return None

    # ── change triage (no network): which folders does a targeted sync need?
    def local_verdict(self, p: str, closed: bool = False) -> tuple[str, float]:
        """Compare what is on disk at logical path p with the last-synced state.
        ('same', 0): nothing to do (our own writes land here); ('settling', secs): a file still
        being written; ('changed', 0): needs a sync. `closed`: inotify saw the writer close it."""
        row = self.S.get(p)
        fp, sp = self.real_path(p), self.stub_path(p)
        st = lstat_or_none(fp)
        if st and stat.S_ISDIR(st.st_mode):
            return ("same" if row and row.kind == "dir" else "changed"), 0.0
        if st and stat.S_ISREG(st.st_mode):
            if fp.suffix in LINK_EXTS and (lid := self._link_id(fp, st)) is not None:
                return ("same" if row and row.state == "gdoc" and lid == row.rid else "changed"), 0.0
            if row and row.state == "local" and st.st_size == row.lsize and abs(st.st_mtime - row.lmtime) <= 1e-3:
                return ("changed" if lstat_or_none(sp) else "same"), 0.0
            age = time.time() - st.st_mtime
            if not closed and 0 <= age < self.acc.settle:
                return "settling", self.acc.settle - age
            return "changed", 0.0
        sst = lstat_or_none(sp)
        if sst and stat.S_ISREG(sst.st_mode):
            xid, orig = self._stub_meta(sp)
            return ("same" if row and row.state == "cloud" and xid == row.rid and orig == p else "changed"), 0.0
        return ("same" if row is None else "changed"), 0.0

    def dirs_for_changes(self, changes: list[dict], root_id: str | None) -> set[str]:
        """Folders touched by Drive Changes API entries: the old folder of every known item and
        the new parent of every item still present. Unknown items in unknown folders are outside
        this account's folder and ignored; changes that match the DB (our own uploads, moves,
        metadata-only edits) are skipped. "Shared with me" has no root folder: an unknown item
        someone else shared with you puts its top level on the list."""
        S = self.S
        paths_by_id: dict[str, list] = {}
        dir_by_id: dict[str, str] = {}
        for p, row in S.items():
            if row.rid:
                paths_by_id.setdefault(row.rid, []).append(p)
                if row.kind == "dir":
                    dir_by_id[row.rid] = p
        if root_id:
            dir_by_id[root_id] = ""
        dirty: set[str] = set()
        for ch in changes:
            if ch.get("changeType", "file") != "file":
                continue
            f = ch.get("file") or {}
            gone = bool(ch.get("removed") or f.get("trashed"))
            old = paths_by_id.get(ch.get("fileId") or "", [])
            if old and not gone and self._change_matches(f, old, root_id):
                continue
            dirty.update(parent(p) for p in old)
            if gone:
                continue
            for par in f.get("parents") or [None]:
                if par in dir_by_id:
                    dirty.add(dir_by_id[par])
                elif self.acc.section == "shared":
                    if f.get("sharedWithMeTime") and not f.get("ownedByMe"):
                        dirty.add("")       # newly shared with you (its parent isn't visible to you)
                elif not root_id and par is not None:
                    dirty.add("")           # can't tell whether it is our top level; look
        return dirty

    def _change_matches(self, f: dict, paths: list[str], root_id: str | None) -> bool:
        for p in paths:
            row, up = self.S[p], parent(p)
            par_id = root_id if up == "" else (self.S[up].rid if up in self.S else "")
            if not par_id or (f.get("parents") or []) != [par_id]:
                return False
            leaf, name = os.path.basename(row.rname or p), f.get("name", "")
            if leaf != (name + ".desktop" if row.kind == "gdoc" else name):
                return False
            if row.kind == "file":
                if f.get("md5Checksum"):
                    if f["md5Checksum"] != row.rhash:
                        return False
                else:
                    a, b = parse_time(f.get("modifiedTime", "")), parse_time(row.rmtime)
                    if a is None or b is None or abs(a - b) > 1:
                        return False
                if "size" in f and int(f["size"]) != row.rsize:
                    return False
        return True

    # ── primitive operations
    def write_stub(self, p: str, r: RItem):
        fp = self.stub_path(p)
        fp.parent.mkdir(parents=True, exist_ok=True)
        fp.write_text(
            f"This file is stored in Google Drive (account '{self.acc.name}') and is not on this computer.\n"
            f"Double-click it, or right-click > Google Drive > Make available offline, to download it.\n"
            f"size: {human(r.size)}\nid: {r.id}\npath: {p}\n")
        if (t := parse_time(r.mtime)) is not None:
            os.utime(fp, (t, t))
        setx(fp, "user.gdrive.id", r.id)
        setx(fp, "user.gdrive.path", p)
        setx(fp, "user.xdg.comment", f"☁ Online only · {human(r.size)}")
        set_status_tag(fp, TAG_ONLINE)
        self.S[p] = Row(p, "file", "cloud", r.id, r.size, r.mtime, r.hash, 0, 0.0, r.rname)

    def write_link(self, p: str, r: RItem):
        fp = self.real_path(p)
        fp.parent.mkdir(parents=True, exist_ok=True)
        data = {"gdrive_od": 1, "account": self.acc.name, "id": r.id, "type": r.gtype,
                "url": f"https://drive.google.com/open?id={r.id}"}
        fp.write_text(json.dumps(data, indent=1) + "\n")
        if (t := parse_time(r.mtime)) is not None:
            os.utime(fp, (t, t))
        setx(fp, "user.gdrive.id", r.id)
        setx(fp, "user.xdg.comment", f"Google {r.gtype or 'file'} · opens in browser")
        set_status_tag(fp, TAG_GOOGLE)
        self.S[p] = Row(p, "gdoc", "gdoc", r.id, 0, r.mtime, "", 0, 0.0, r.rname)

    def download(self, p: str, r: RItem):
        final = self.real_path(p)
        final.parent.mkdir(parents=True, exist_ok=True)
        tmp = final.with_name("." + final.name + TMP_EXT)
        try:
            rclone(self.acc, "copyto", self.acc.rpath(r.rname), str(tmp))
            os.replace(tmp, final)
        finally:
            tmp.unlink(missing_ok=True)
        self.stub_path(p).unlink(missing_ok=True)
        st = final.stat()
        self.S[p] = Row(p, "file", "local", r.id, r.size, r.mtime, r.hash, st.st_size, st.st_mtime, r.rname)
        set_status_tag(final, TAG_OFFLINE)
        log.info("↓ %s", p)
        self.on_event("download", p)

    def upload(self, p: str):
        fp = self.real_path(p)
        st = fp.stat()
        if self.refused_before(p, [st.st_size, st.st_mtime]):
            return
        if not self.placeable(p):
            return self.refuse(p, [st.st_size, st.st_mtime], "not inside a folder that exists in Drive")
        try:
            rclone(self.acc, "copyto", str(fp), self.acc.rpath(p))
        except RcloneError as e:
            if not permission_denied(e):
                raise
            return self.refuse(p, [st.st_size, st.st_mtime], "no permission to upload")
        r = self.stat_remote(p)
        self.S[p] = Row(p, "file", "local", r.id, r.size, r.mtime, r.hash, st.st_size, st.st_mtime, p)
        set_status_tag(fp, TAG_OFFLINE)
        self.forget_refusal(p)
        log.info("↑ %s", p)
        self.on_event("upload", p)

    def delete_remote(self, p: str, row: Row, r: RItem | None = None):
        if r is not None and not self.owns(r):               # never delete someone else's file
            return self.restore(p, row, r)
        try:
            rclone(self.acc, "deletefile", self.acc.rpath(row.rname or p))   # Drive: goes to trash
        except RcloneError as e:
            if not permission_denied(e):
                raise
            return self.restore(p, row, r or row.as_ritem())
        self.S.pop(p, None)
        log.info("✗ remote %s", p)
        self.on_event("deleted in Drive", p)

    # ── shared content: ownership and refused operations
    def placeable(self, p: str) -> bool:
        """"Shared with me" has no folder of its own: new items can only go inside a shared folder
        that exists in Drive (else rclone would create it in My Drive)."""
        if self.acc.section != "shared":
            return True
        top = self.S.get(p.split("/", 1)[0])
        return "/" in p and top is not None and top.kind == "dir"

    def owns(self, r: RItem) -> bool:
        """In "Shared with me" only items you own may be deleted or moved from here."""
        return self.acc.section != "shared" or not r.owner or not self.acc.email \
            or r.owner.casefold() == self.acc.email.casefold()

    def restore(self, p: str, row: Row, r: RItem):
        """The deletion isn't allowed: the item comes back here as online-only."""
        if row.kind == "gdoc":
            self.write_link(p, r)
        else:
            self.write_stub(p, r)
        self.restored.append(p)
        log.info("↺ %s put back (owned by %s)", p, r.owner or "someone else")
        self.on_event("put back", p)

    def refused_before(self, p: str, version: list) -> bool:
        return self.denied.get(p) == version

    def refuse(self, p: str, version: list, why: str):
        """Drive won't take this (version of a) local item: keep it here, don't retry until it changes."""
        self.denied[p] = version
        self.refused.append(p)
        log.warning("%s: %s stays only on this computer (%s)", self.acc.title, p, why)
        self.on_event("kept here only", p)

    def forget_refusal(self, p: str):
        self.denied.pop(p, None)

    def _mkdir_remote(self, p: str, created: list):
        if self.refused_before(p, ["dir"]):
            return
        if not self.placeable(p):
            return self.refuse(p, ["dir"], "not inside a folder that exists in Drive")
        try:
            rclone(self.acc, "mkdir", self.acc.rpath(p))
        except RcloneError as e:
            if not permission_denied(e):
                raise
            return self.refuse(p, ["dir"], "no permission to create folders here")
        self.S[p] = Row(p, "dir", "dir", rname=p)
        created.append(p)

    def delete_local(self, p: str, fp: Path):
        trash_local(fp, self.acc)
        self.S.pop(p, None)
        log.info("✗ local %s", p)
        self.on_event("deleted here", p)

    def conflict(self, p: str, r: RItem):
        stem, suf = os.path.splitext(p)
        newp = f"{stem} (conflict {socket.gethostname()} {dt.datetime.now():%Y-%m-%d %H%M}){suf}"
        os.rename(self.real_path(p), self.real_path(newp))
        self.upload(newp)
        self.download(p, r)
        notify("Google Drive: sync conflict", f"Both copies of {os.path.basename(p)} changed.\n"
                                              f"Your version was saved as {os.path.basename(newp)}")
        log.warning("conflict on %s -> kept local as %s", p, newp)
        self.on_event("conflict", newp)

    def adopt_or_conflict(self, p: str, r: RItem, l: LItem):
        if l.size == r.size and (not r.hash or md5_file(l.fpath) == r.hash):
            self.S[p] = Row(p, "file", "local", r.id, r.size, r.mtime, r.hash, l.size, l.mtime, r.rname)
            set_status_tag(l.fpath, TAG_OFFLINE)
        else:
            self.conflict(p, r)

    def hydrate(self, p: str):
        row = self.S.get(p)
        if not row or row.state != "cloud":
            return
        self.download(p, row.as_ritem())

    def dehydrate(self, p: str) -> bool:
        row = self.S.get(p)
        fp = self.real_path(p)
        if not row or row.state != "local" or not fp.exists():
            return False
        st = fp.stat()
        if st.st_size != row.lsize or abs(st.st_mtime - row.lmtime) > 1e-3:   # unsynced local edits
            cur = self.stat_remote(row.rname)
            if remote_changed(row, cur):
                notify("Google Drive", f"{fp.name} changed both here and online; run a sync first.")
                return False
            self.upload(p)
            row = self.S[p]
        self.write_stub(p, row.as_ritem())
        fp.unlink()
        log.info("☁ %s", p)
        return True

    # ── the sync
    def sync(self, force: bool = False, dirs: set[str] | None = None, fresh=frozenset(), busy=frozenset()):
        """3-way merge of remote (R), last-synced (S) and local (L) state.
        dirs=None: the whole tree. Otherwise a targeted sync of the direct children of `dirs`,
        widened to whole subtrees where folders appeared, vanished or moved (see _gather).
        fresh: files whose writer has closed them (inotify); they skip the `settle` wait.
        busy: paths with local events still arriving (e.g. mid-"safe save", when the file is
        briefly missing); nothing is done to them now, they get their own sync once quiet."""
        acc, S = self.acc, self.S
        self.dupe_stubs, self.deferred, self.restored, self.refused = [], {}, [], []
        denied_before = dict(self.denied)
        files_in_S = sum(1 for r in S.values() if r.kind != "dir")
        if dirs is None:
            scope = Scope(deep={""})
            R = self.list_remote()
            L, Ldirs, _ = self.scan_local()
            if not R and files_in_S and not force:
                raise RuntimeError("Remote listing is empty but files were synced before — refusing "
                                   "(use 'gdrive-od sync --force' if you really emptied the Drive).")
            if not L and not Ldirs and files_in_S and not force:
                raise RuntimeError(f"The local folder {acc.local} is empty but files were synced before — "
                                   f"refusing (use 'gdrive-od sync --force {acc.owner or acc.name}' if you "
                                   "really want everything deleted in Drive too).")
        else:
            scope, R, L, Ldirs = self._gather(dirs)
        inside = scope.contains
        for fp in self.dupe_stubs:
            fp.unlink(missing_ok=True)

        scope.busy = frozenset(busy)
        if busy:
            R = {p: r for p, r in R.items() if p not in busy}
            L, Ldirs = {p: l for p, l in L.items() if p not in busy}, Ldirs - busy

        # 1. remote moves/renames (same Drive ID, new path) -> rename locally
        if self._apply_remote_moves(R, scope):
            L, Ldirs = self._scan_scope(scope)
            if busy:
                L, Ldirs = {p: l for p, l in L.items() if p not in busy}, Ldirs - busy
        # 2. local moves/renames -> server-side move (no re-upload)
        self._apply_local_moves(R, L, Ldirs, scope)
        self.db.save(S)          # moves already happened on disk and online

        now = time.time()

        def settling(l: LItem) -> bool:
            if l.kind != "real" or l.path in fresh:
                return False
            age = now - l.mtime
            if 0 <= age < acc.settle:
                self.deferred[l.path] = acc.settle - age
                return True
            return False

        early, acts, late, created = [], [], [], []
        n_del_remote = n_del_local = 0

        # 3. directories
        Rd = {p for p, r in R.items() if r.kind == "dir"}
        Sd = {p for p, r in S.items() if r.kind == "dir" and inside(p)}
        for p in sorted(Rd - Ldirs):
            if p in Sd:      # synced before, deleted locally
                late.append((p.count("/"), lambda p=p: self._rmdir_remote(p, R[p])))
            else:
                early.append(lambda p=p: (self.real_path(p).mkdir(parents=True, exist_ok=True),
                                          S.__setitem__(p, Row(p, "dir", "dir", R[p].id, rname=p))))
        for p in sorted(Ldirs - Rd):
            if p in Sd:      # synced before, deleted remotely
                late.append((p.count("/"), lambda p=p: self._rmdir_local(p)))
            else:
                early.append(lambda p=p: self._mkdir_remote(p, created))
        for p in Rd & Ldirs:
            S[p] = Row(p, "dir", "dir", R[p].id, rname=p)

        # 4. files: 3-way merge of remote (R), last-synced (S), local (L)
        keys = {p for p, r in R.items() if r.kind != "dir"} | \
               {p for p, r in S.items() if r.kind != "dir" and inside(p)} | set(L)
        for p in sorted(keys):
            r = R.get(p) if (R.get(p) and R[p].kind != "dir") else None
            s = S.get(p) if (S.get(p) and S[p].kind != "dir") else None
            l = L.get(p)

            # Google Docs/Sheets/... : always a small link file
            if (r and r.kind == "gdoc") or (s and s.kind == "gdoc") or (l and l.kind == "link"):
                if r and r.kind == "gdoc":
                    if l and l.kind == "link":
                        if not s or l.xid != r.id:
                            acts.append(lambda p=p, r=r: self.write_link(p, r))
                        else:
                            S[p] = replace(s, rmtime=r.mtime, rname=r.rname)
                    elif l is None and s:            # link deleted locally -> trash the doc
                        n_del_remote += 1
                        acts.append(lambda p=p, s=s, r=r: self.delete_remote(p, s, r))
                    elif l is None:
                        acts.append(lambda p=p, r=r: self.write_link(p, r))
                else:                                 # gone remotely / orphan link
                    if l and l.kind == "link":
                        acts.append(lambda p=p, l=l: (l.fpath.unlink(missing_ok=True), S.pop(p, None)))
                    elif s:
                        S.pop(p, None)
                continue

            if r and s:
                rc = remote_changed(s, r)
                if s.state == "cloud":
                    if l and l.kind == "stub":
                        if self.pinned(p):
                            acts.append(lambda p=p, r=r: self.download(p, r))
                        elif rc or l.xid != r.id or l.orig != p:
                            acts.append(lambda p=p, r=r: self.write_stub(p, r))
                    elif l and l.kind == "real":
                        if not settling(l):
                            acts.append(lambda p=p, r=r, l=l: self.adopt_or_conflict(p, r, l))
                    elif rc:                          # stub deleted but file changed online: keep it
                        acts.append(lambda p=p, r=r: self.write_stub(p, r))
                    else:                             # placeholder deleted -> trash online
                        n_del_remote += 1
                        acts.append(lambda p=p, s=s, r=r: self.delete_remote(p, s, r))
                else:  # local
                    if l and l.kind == "real":
                        lc = local_changed(s, l)
                        if lc and settling(l):
                            continue
                        if lc and rc:
                            acts.append(lambda p=p, r=r, l=l: self.adopt_or_conflict(p, r, l))
                        elif lc:
                            acts.append(lambda p=p: self.upload(p))
                        elif rc:
                            acts.append(lambda p=p, r=r: self.download(p, r))
                        else:
                            set_status_tag(l.fpath, TAG_OFFLINE)
                    elif l and l.kind == "stub":
                        S[p] = replace(s, state="cloud", lsize=0, lmtime=0.0)
                    elif rc:                          # deleted locally but changed online: restore
                        acts.append(lambda p=p, r=r: self.download(p, r))
                    else:
                        n_del_remote += 1
                        acts.append(lambda p=p, s=s, r=r: self.delete_remote(p, s, r))
            elif r:                                   # new on the remote
                if l is None:
                    if self.pinned(p):
                        acts.append(lambda p=p, r=r: self.download(p, r))
                    else:
                        acts.append(lambda p=p, r=r: self.write_stub(p, r))
                elif l.kind == "real":
                    if not settling(l):
                        acts.append(lambda p=p, r=r, l=l: self.adopt_or_conflict(p, r, l))
                else:
                    acts.append(lambda p=p, r=r: self.write_stub(p, r))
            elif s:                                   # deleted on the remote
                if l and l.kind == "real":
                    if s.state == "local" and not local_changed(s, l):
                        n_del_local += 1
                        acts.append(lambda p=p, l=l: self.delete_local(p, l.fpath))
                    elif not settling(l):             # edited locally: keep and re-upload
                        acts.append(lambda p=p: self.upload(p))
                elif l:
                    acts.append(lambda p=p, l=l: (l.fpath.unlink(missing_ok=True), S.pop(p, None)))
                else:
                    S.pop(p, None)
            elif l:                                   # new local file
                if l.kind == "real":
                    if not settling(l):
                        acts.append(lambda p=p: self.upload(p))
                else:
                    acts.append(lambda l=l: l.fpath.unlink(missing_ok=True))

        cap = max(25, files_in_S * acc.max_delete_pct // 100)
        if not force and (n_del_remote > cap or n_del_local > cap):
            raise RuntimeError(f"Safety stop: this sync would delete {n_del_remote} files online and "
                               f"{n_del_local} locally (limit {cap}). Check the folder, then run "
                               f"'gdrive-od sync --force {acc.name}' if intended.")

        errors = 0
        steps = early + acts + [f for _, f in sorted(late, key=lambda x: -x[0])]
        for i, fn in enumerate(steps):
            if self.cancelled():
                log.info("stopping: %d step(s) left for the next sync", len(steps) - i)
                break
            try:
                fn()
            except Exception as e:
                errors += 1
                log.error("%s", e)
        if created:
            self._fill_dir_ids(created)
        self.db.save(S)
        if self.denied != denied_before:
            self.db.set_meta("denied", json.dumps(self.denied))
        if errors:
            notify("Google Drive", f"{acc.title}: {errors} item(s) failed to sync; see "
                                   f"'journalctl --user -u gdrive-od@{acc.owner or acc.name}'")
        if self.restored:
            notify("Google Drive", f"{acc.title}: put back {len(self.restored)} item(s) you can't delete "
                                   f"(e.g. {os.path.basename(self.restored[0])}): only the owner can.")
        if self.refused:
            notify("Google Drive", f"{acc.title}: {len(self.refused)} item(s) stay only on this computer "
                                   f"(e.g. {os.path.basename(self.refused[0])}): no permission or no place in Drive.")
        if dirs is None:
            log.info("sync done for %s (%d errors)", acc.title, errors)
        elif steps or errors:
            log.info("targeted sync done for %s: %d step(s), %d errors", acc.title, len(steps), errors)

    def _fill_dir_ids(self, created: list[str]):
        """Folders we just created online: record their Drive IDs (needed to map Drive changes)."""
        for up in sorted({parent(p) for p in created}):
            try:
                listing = self.list_remote(up, recursive=False)
            except RuntimeError as e:
                log.debug("cannot list %s: %s", up or "/", e)
                continue
            for p in created:
                if parent(p) == up and p in self.S and p in listing and listing[p].id:
                    self.S[p] = replace(self.S[p], rid=listing[p].id)

    def _rmdir_local(self, p: str):
        try:
            self.real_path(p).rmdir()
            self.S.pop(p, None)
        except OSError:
            pass  # still has unsynced local content; keep it

    def _rmdir_remote(self, p: str, r: RItem | None = None):
        if r is not None and not self.owns(r):
            self.real_path(p).mkdir(parents=True, exist_ok=True)     # someone else's folder: put it back
            return
        try:
            rclone(self.acc, "rmdir", self.acc.rpath(p))
            self.S.pop(p, None)
        except RcloneError as e:
            if permission_denied(e):
                self.real_path(p).mkdir(parents=True, exist_ok=True)
            # otherwise not empty (new files online) -> recreated locally next cycle

    def _move_pins(self, old: str, new: str):
        if any(under(q, old) for q in self.pins):
            self.db.move_pins(old, new)
            self.pins = self.db.pins()

    def _apply_remote_moves(self, R: dict[str, RItem], scope: Scope) -> bool:
        S = self.S
        byid = {r.id: r for r in R.values() if r.id}
        moved = False
        for p in sorted([p for p in S if scope.contains(p)], key=lambda k: k.count("/")):
            row = S.get(p)
            if row is None or p in R or not row.rid:
                continue
            r = byid.get(row.rid)
            if not r or r.path in S or r.kind != row.kind or r.path in scope.busy:
                continue
            if row.kind == "dir":
                old, new = self.real_path(p), self.real_path(r.path)
            elif row.state == "cloud":
                old, new = self.stub_path(p), self.stub_path(r.path)
            else:
                old, new = self.real_path(p), self.real_path(r.path)
            if not old.exists() or new.exists():
                continue
            new.parent.mkdir(parents=True, exist_ok=True)
            os.rename(old, new)
            moved = True
            log.info("⇄ local rename %s -> %s", p, r.path)
            self.on_event("moved", f"{p} → {r.path}")
            if row.kind == "dir":
                rekey(S, p, r.path)
                self._move_pins(p, r.path)
            else:
                S.pop(p)
                S[r.path] = replace(row, path=r.path, rname=r.rname)
        return moved

    def _apply_local_moves(self, R: dict[str, RItem], L: dict[str, LItem], Ldirs: set[str], scope: Scope):
        S = self.S
        self._apply_local_dir_moves(R, L, Ldirs, scope)
        missing = {p: row for p, row in S.items()
                   if row.kind != "dir" and scope.contains(p) and p not in L and p in R
                   and not remote_changed(row, R[p])}
        by_rid = {row.rid: p for p, row in missing.items() if row.rid}
        sigs: dict = {}
        for p, row in missing.items():
            if row.state == "local":
                sigs.setdefault((row.lsize, round(row.lmtime, 3)), []).append(p)
        for l in [l for l in L.values() if l.path not in S]:
            oldp = None
            if l.kind in ("stub", "link") and l.xid:
                oldp = by_rid.get(l.xid)
            if not oldp and l.kind == "stub" and l.orig in missing:
                oldp = l.orig
            if not oldp and l.kind == "real":
                c = sigs.get((l.size, round(l.mtime, 3)), [])
                oldp = c[0] if len(c) == 1 else None
            if not oldp or oldp not in missing:
                continue
            row = missing.pop(oldp)
            if {"stub": "cloud", "link": "gdoc", "real": "local"}[l.kind] != row.state:
                continue
            if not self.owns(R[oldp]) or not self.placeable(l.path):   # undone by the merge below
                continue
            new_rname = l.path if row.kind == "file" else os.path.splitext(l.path)[0] + ".desktop"
            try:
                rclone(self.acc, "moveto", self.acc.rpath(row.rname), self.acc.rpath(new_rname))
            except RuntimeError as e:
                log.error("%s", e)
                continue
            log.info("⇄ remote move %s -> %s", oldp, l.path)
            self.on_event("moved in Drive", f"{oldp} → {l.path}")
            S.pop(oldp)
            S[l.path] = replace(row, path=l.path, rname=new_rname)
            r = R.pop(oldp)
            R[l.path] = replace(r, path=l.path, rname=new_rname)
            if l.kind == "stub":
                l.fpath.unlink(missing_ok=True)
                self.write_stub(l.path, R[l.path])
                l.orig = l.path

    def _apply_local_dir_moves(self, R: dict[str, RItem], L: dict[str, LItem], Ldirs: set[str], scope: Scope):
        """A folder renamed/moved locally -> one server-side move, which keeps its Drive ID,
        sharing and contents. Only when the match is unambiguous: same entry names, and at least
        one placeholder/link with the same Drive ID or file with the same size and mtime."""
        S = self.S
        gone = [p for p, row in S.items()
                if row.kind == "dir" and scope.contains(p) and scope.is_deep(p) and p not in Ldirs
                and p in R and R[p].kind == "dir" and (not row.rid or R[p].id == row.rid)]
        new = [d for d in Ldirs if d not in S and d not in R and scope.is_deep(d) and d not in scope.busy]
        if not gone or not new:
            return
        skids: dict[str, set] = {}
        for k in S:
            skids.setdefault(parent(k), set()).add(k.rsplit("/", 1)[-1])
        lkids: dict[str, set] = {}
        for k in [*L, *Ldirs]:
            lkids.setdefault(parent(k), set()).add(k.rsplit("/", 1)[-1])

        def same_folder(m: str, d: str) -> bool:
            names = skids.get(m, set())
            if names != lkids.get(d, set()):
                return False
            strong = 0
            for n in names:
                row, l = S.get(join(m, n)), L.get(join(d, n))
                if not row or not l or row.kind == "dir":
                    continue
                if l.kind in ("stub", "link"):
                    if l.xid and row.rid and l.xid != row.rid:
                        return False
                    strong += bool(l.xid and l.xid == row.rid)
                elif row.state == "local" and l.size == row.lsize and abs(l.mtime - row.lmtime) <= 1e-3:
                    strong += 1
            return strong > 0 or not names

        matches = {}
        for m in gone:
            cands = [d for d in new if same_folder(m, d)]
            if len(cands) == 1:
                matches[m] = cands[0]
        claimed = Counter(matches.values())
        for m in sorted(matches, key=lambda k: k.count("/")):
            d = matches[m]
            if claimed[d] > 1 or m not in S or d in S or not self.owns(R[m]) or not self.placeable(d):
                continue
            try:
                rclone(self.acc, "moveto", self.acc.rpath(S[m].rname or m), self.acc.rpath(d))
            except RuntimeError as e:
                log.error("%s", e)
                continue
            log.info("⇄ remote move %s/ -> %s/", m, d)
            self.on_event("moved in Drive", f"{m}/ → {d}/")
            rekey(S, m, d)
            rekey(R, m, d)
            self._move_pins(m, d)


def remote_changed(s: Row, r: RItem) -> bool:
    if s.rhash and r.hash:
        return s.rhash != r.hash
    return s.rsize != r.size or s.rmtime != r.mtime


def local_changed(s: Row, l: LItem) -> bool:
    return s.lsize != l.size or abs(s.lmtime - l.mtime) > 1e-3


# ───────────────────────────── Drive Changes API ─────────────────────────────
class AuthError(RuntimeError):
    pass


def sign_in_expired(e: Exception) -> bool:
    """Google rejected the refresh token (revoked, password change, or the 7-day limit of an
    OAuth app in 'Testing' status): only signing in again helps."""
    s = str(e)
    return any(k in s for k in ("invalid_grant", "expired or revoked", "rclone config reconnect"))


def permission_denied(e: Exception) -> bool:
    """Drive refused because of your role on the item (viewer, not the owner...), not a rate limit."""
    s = str(e)
    return any(k in s for k in ("insufficientFilePermissions", "insufficientPermissions",
                                "sufficient permissions", "cannotAddChildren"))


def notify_reconnect(acc: Account):
    notify("Google Drive — sign-in expired",
           f"'{acc.name}' ({acc.email or acc.remote}) must sign in to Google again: right-click in its "
           f"folder > Google Drive > Reconnect account, or run 'gdrive-od reconnect {acc.name}'.")


class ApiError(RuntimeError):
    def __init__(self, code: int, msg: str):
        super().__init__(f"Drive API error {code}: {msg}")
        self.code = code


class TooManyChanges(Exception):
    pass


def split_remote(remote: str) -> tuple[str, str]:
    """'gdrive:Docs/Work' -> ('gdrive', 'Docs/Work'). Local paths -> ('', path)."""
    if ":" not in remote or remote.startswith(("/", ".", "~")):
        return "", remote
    name, path = remote.split(":", 1)
    if not name or "/" in name:
        return "", remote
    return name, path


class DriveChanges:
    """Drive -> local change feed: Drive API v3 changes.list, authenticated with rclone's OAuth
    token. The token is read from `rclone config dump`. When it expires it is refreshed with the
    remote's own client_id/secret if it has them, otherwise rclone refreshes it (and saves it)
    the next time it talks to Drive, which `rclone about` makes happen."""
    API = "https://www.googleapis.com/drive/v3"
    TOKEN_URL = "https://oauth2.googleapis.com/token"
    FIELDS = ("nextPageToken,newStartPageToken,changes(changeType,removed,fileId,"
              "file(name,mimeType,parents,trashed,md5Checksum,size,modifiedTime,ownedByMe,sharedWithMeTime))")
    MAX_CHANGES = 5000          # beyond this a full sync is cheaper

    def __init__(self, acc: Account, name: str, params: dict):
        self.acc, self.name, self.params = acc, name, params     # name: "gdrive" or "gdrive,opt=x"
        self.drive_id = params.get("team_drive") or ""
        self.api_base = os.environ.get("GDOD_DRIVE_API") or self.API
        self.token_url = os.environ.get("GDOD_TOKEN_URL") or params.get("token_url") or self.TOKEN_URL
        self._token, self._expiry = "", 0.0

    @classmethod
    def for_account(cls, acc: Account) -> DriveChanges | None:
        name, _ = split_remote(acc.remote)
        if not name:
            log.info("%s: Drive change feed off (%s is not an rclone remote)", acc.name, acc.remote)
            return None
        try:
            dump = json.loads(rclone(acc, "config", "dump"))
        except (RuntimeError, ValueError) as e:
            log.warning("%s: Drive change feed off, cannot read the rclone config: %s", acc.name, e)
            return None
        base, *opts = name.split(",")
        params = dict(dump.get(base) or {})
        for o in opts:
            k, _, v = o.partition("=")
            params[k.strip()] = v.strip().strip("'\"")
        if params.get("type") != "drive":
            log.info("%s: Drive change feed off (remote %s is not Google Drive)", acc.name, base)
            return None
        if not params.get("token"):
            log.info("%s: Drive change feed off (remote %s has no OAuth token; service accounts are "
                     "not supported)", acc.name, base)
            return None
        return cls(acc, name, params)

    # ── auth
    def _config_token(self) -> dict:
        dump = json.loads(rclone(self.acc, "config", "dump"))
        try:
            return json.loads((dump.get(self.name.split(",")[0]) or {}).get("token") or "{}")
        except ValueError:
            return {}

    def _use(self, tok: dict, min_left: float, stale: str) -> bool:
        exp = parse_time(tok.get("expiry") or "") or 0.0
        if tok.get("access_token") and tok["access_token"] != stale and exp - time.time() > min_left:
            self._token, self._expiry = tok["access_token"], exp
            return True
        return False

    def access_token(self, force: bool = False) -> str:
        """A valid access token. force=True: the current one was rejected, get another."""
        if not force and self._token and self._expiry - time.time() > 15:
            return self._token
        stale = self._token if force else ""
        tok = self._config_token()                  # another rclone run may have refreshed it
        if self._use(tok, 15, stale):
            return self._token
        cid, secret = self.params.get("client_id"), self.params.get("client_secret")
        if cid and secret and tok.get("refresh_token"):
            body = urllib.parse.urlencode({"client_id": cid, "client_secret": secret, "grant_type": "refresh_token",
                                           "refresh_token": tok["refresh_token"]}).encode()
            try:
                d = self._http(urllib.request.Request(self.token_url, data=body))
            except ApiError as e:
                raise AuthError(f"token refresh failed: {e}") from None
            self._token, self._expiry = d["access_token"], time.time() + int(d.get("expires_in", 3600))
            return self._token
        try:            # rclone's own client: any authenticated rclone call refreshes and saves the token
            rclone(self.acc, "about", self.name + ":")
        except RuntimeError as e:
            raise AuthError(f"rclone could not refresh its token: {e}") from None
        if self._use(self._config_token(), 5, stale):
            return self._token
        raise AuthError(f"no usable access token for rclone remote {self.name}: "
                        f"run 'rclone config reconnect {self.name}:'")

    # ── HTTP
    @staticmethod
    def _http(req: urllib.request.Request, timeout: float = 30) -> dict:
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read() or b"{}")
        except urllib.error.HTTPError as e:
            raise ApiError(e.code, e.read()[:300].decode(errors="replace").strip()) from None

    def api(self, path: str, **params) -> dict:
        url = f"{self.api_base}/{path}?{urllib.parse.urlencode(params)}"
        for force in (False, True):
            req = urllib.request.Request(url, headers={"Authorization": "Bearer " + self.access_token(force)})
            try:
                return self._http(req)
            except ApiError as e:
                if e.code != 401 or force:
                    raise
        raise AssertionError("unreachable")

    # ── the feed
    def _drive_params(self) -> dict:
        p = {"supportsAllDrives": "true"}
        if self.drive_id:                       # a Shared Drive remote (team_drive = ...)
            p["driveId"] = self.drive_id
        return p

    def start_token(self) -> str:
        return self.api("changes/startPageToken", **self._drive_params())["startPageToken"]

    def list_changes(self, token: str) -> tuple[list[dict], str]:
        """Every change since `token`, and the token to continue from. My Drive remotes don't
        ask for Shared Drive items (busy organisation drives would only add noise)."""
        extra = {"includeItemsFromAllDrives": "true"} if self.drive_id else {}
        out: list[dict] = []
        while True:
            d = self.api("changes", pageToken=token, pageSize=1000, fields=self.FIELDS,
                         **self._drive_params(), **extra)
            out += d.get("changes", [])
            if d.get("newStartPageToken"):
                return out, d["newStartPageToken"]
            if len(out) > self.MAX_CHANGES:
                raise TooManyChanges()
            token = d.get("nextPageToken")
            if not token:
                raise ApiError(0, "changes.list returned no page token")

    def root_id(self) -> str:
        """Drive ID of the folder this account syncs (parent ID of its top-level items); None for
        "Shared with me", which has no folder of its own."""
        if str(self.params.get("shared_with_me", "")).lower() in ("true", "1"):
            return None
        _, sub = split_remote(self.acc.remote)
        sub = sub.strip("/")
        if sub:
            up, _, leaf = sub.rpartition("/")
            for e in json.loads(rclone(self.acc, "lsjson", "--dirs-only", f"{self.name}:{up}") or "[]"):
                if e.get("Name") == leaf and e.get("ID"):
                    return e["ID"]
            raise RuntimeError(f"folder {sub} not found on {self.name}:")
        if self.params.get("root_folder_id"):
            return self.params["root_folder_id"]
        if self.drive_id:
            return self.drive_id
        return self.api("files/root", fields="id")["id"]


# ───────────────────────────── inotify ─────────────────────────────
IN_MODIFY, IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO = 0x2, 0x8, 0x40, 0x80
IN_CREATE, IN_DELETE, IN_DELETE_SELF, IN_MOVE_SELF = 0x100, 0x200, 0x400, 0x800
IN_UNMOUNT, IN_Q_OVERFLOW, IN_IGNORED = 0x2000, 0x4000, 0x8000
IN_ONLYDIR, IN_DONT_FOLLOW, IN_EXCL_UNLINK, IN_ISDIR = 0x1000000, 0x2000000, 0x4000000, 0x40000000
INOTIFY_EVENT = struct.Struct("iIII")       # wd, mask, cookie, len; then the name


class Watcher:
    """Recursive inotify watch on a folder (libc through ctypes). A thread drains the kernel queue
    into `pending` (path -> [monotonic time of last event, writer closed it]) so the queue can't
    overflow during long syncs. New folders get watches as they appear; xattr changes (Dolphin
    tags, our status tags) are not watched at all."""
    MASK = (IN_MODIFY | IN_CLOSE_WRITE | IN_MOVED_FROM | IN_MOVED_TO | IN_CREATE | IN_DELETE |
            IN_DELETE_SELF | IN_MOVE_SELF | IN_ONLYDIR | IN_DONT_FOLLOW | IN_EXCL_UNLINK)
    _libc = None

    def __init__(self, root: Path, wake: threading.Event | None = None):
        if Watcher._libc is None:
            libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
            libc.inotify_init1.argtypes = [ctypes.c_int]
            libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
            libc.inotify_rm_watch.argtypes = [ctypes.c_int, ctypes.c_int]
            Watcher._libc = libc
        self.fd = self._libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        if self.fd < 0:
            err = ctypes.get_errno()
            raise OSError(err, f"inotify_init1: {os.strerror(err)}")
        self.root, self.wake = root, wake or threading.Event()
        self.lock = threading.Lock()
        self.wd2dir: dict[int, str] = {}
        self.pending: dict[str, list] = {}
        self.overflow = False
        self.alive = True           # False once the root itself is gone
        self.complete = True        # False when the inotify watch limit was hit
        self._moves: dict[int, str] = {}        # cookie -> folder moved away (pairs with MOVED_TO)
        self._pipe = os.pipe()
        self._add_tree("", report=False)
        if "" not in self.wd2dir.values():
            os.close(self.fd)
            raise OSError(errno.ENOENT, f"cannot watch {root}")
        self.thread = threading.Thread(target=self._run, name="inotify", daemon=True)
        self.thread.start()

    def healthy(self) -> bool:
        return self.alive and self.complete

    def take(self, min_age: float) -> dict[str, bool]:
        """Paths whose last event is at least min_age seconds old -> writer closed the file."""
        return {p: v[0] for p, v in self.take_entries(min_age).items()}

    def take_entries(self, min_age: float) -> dict[str, tuple[bool, bool]]:
        """Like take(), with (writer closed it, was a folder) per path."""
        now = time.monotonic()
        with self.lock:
            ready = {p: (v[1], v[2]) for p, v in self.pending.items() if now - v[0] >= min_age}
            for p in ready:
                del self.pending[p]
        return ready

    def next_ready(self, min_age: float) -> float | None:
        with self.lock:
            return min((v[0] for v in self.pending.values()), default=-1.0) + min_age if self.pending else None

    def take_overflow(self) -> bool:
        with self.lock:
            o, self.overflow = self.overflow, False
            return o

    def close(self):
        try:
            os.write(self._pipe[1], b"x")
            self.thread.join(5)
        finally:
            for fd in (self.fd, *self._pipe):
                try:
                    os.close(fd)
                except OSError:
                    pass

    def _add_tree(self, rel: str, report: bool = True):
        """Watch folder `rel` and everything below it. report: also mark what is already inside
        as changed (it may have appeared before the watch existed)."""
        now = time.monotonic()
        for dirpath, dirnames, filenames in os.walk(self.root / rel if rel else self.root):
            r = os.path.relpath(dirpath, self.root)
            r = "" if r == "." else r
            wd = self._libc.inotify_add_watch(self.fd, os.fsencode(dirpath), self.MASK)
            if wd < 0:
                if ctypes.get_errno() == errno.ENOSPC and self.complete:
                    self.complete = False
                    log.warning("inotify watch limit reached (fs.inotify.max_user_watches): some folders "
                                "are only synced by the periodic full sync")
                dirnames[:] = []
                continue
            self.wd2dir[wd] = r
            dirnames[:] = [d for d in dirnames
                           if not ignored_name(d) and not os.path.islink(os.path.join(dirpath, d))]
            if report:
                for n in filenames:
                    if not ignored_name(n):
                        self.pending[join(r, n)] = [now, False, False]
                for n in dirnames:
                    self.pending[join(r, n)] = [now, False, True]

    def _unwatch(self, rel: str):
        for wd, d in list(self.wd2dir.items()):
            if under(d, rel):
                self._libc.inotify_rm_watch(self.fd, wd)
                del self.wd2dir[wd]

    def _run(self):
        try:
            while True:
                r, _, _ = select.select([self.fd, self._pipe[0]], [], [])
                if self._pipe[0] in r:
                    return
                try:
                    data = os.read(self.fd, 1 << 16)
                except BlockingIOError:
                    continue
                with self.lock:
                    news = self._parse(data)
                    for rel in self._moves.values():        # moved out of the tree: stop watching
                        self._unwatch(rel)
                    self._moves.clear()
                if news:
                    self.wake.set()
        except Exception as e:
            log.error("inotify watcher stopped: %s", e)
            with self.lock:
                self.alive, self.overflow = False, True
            self.wake.set()

    def _parse(self, data: bytes) -> bool:
        """Apply a buffer of events. True if the daemon should look (new path, overflow...);
        more events for an already-pending path only push its timestamp back."""
        now = time.monotonic()
        news = False
        off = 0
        while off + INOTIFY_EVENT.size <= len(data):
            wd, mask, cookie, n = INOTIFY_EVENT.unpack_from(data, off)
            name = os.fsdecode(data[off + INOTIFY_EVENT.size:off + INOTIFY_EVENT.size + n].split(b"\0", 1)[0])
            off += INOTIFY_EVENT.size + n
            if mask & IN_Q_OVERFLOW:
                self.overflow = news = True
                continue
            d = self.wd2dir.get(wd)
            if mask & IN_IGNORED:
                self.wd2dir.pop(wd, None)
                if d == "":
                    self.alive, self.overflow, news = False, True, True
                continue
            if d is None:
                continue
            if not name:            # about the watched folder itself; its parent reports it
                if d == "" and mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_UNMOUNT):
                    self.alive, self.overflow, news = False, True, True
                continue
            if ignored_name(name):
                continue
            rel = join(d, name)
            if mask & IN_ISDIR:
                if mask & IN_MOVED_FROM:
                    self._moves[cookie] = rel
                elif mask & IN_MOVED_TO and self._moves.pop(cookie, None) is not None:
                    self._add_tree(rel, report=False)       # renamed inside the tree: re-map watches
                elif mask & (IN_CREATE | IN_MOVED_TO):
                    self._add_tree(rel)
                    news = True
            news = news or rel not in self.pending
            was_dir = bool(mask & IN_ISDIR) or (rel in self.pending and self.pending[rel][2])
            self.pending[rel] = [now, not mask & (IN_CREATE | IN_MODIFY), was_dir]
        return news


# ───────────────────────────── status (for gdrive-od-ui) ─────────────────────────────
def status_path(name: str) -> Path:
    return STATE_DIR / f"{name}.status.json"


def backup_pause_flag(name: str) -> Path:
    return STATE_DIR / f"{name}.backup-paused"


class StatusBoard:
    """What an account's daemon is doing, published as STATE_DIR/<account>.status.json (written
    atomically, at most every 2 s, only after a change) for gdrive-od-ui: per sync root its state,
    last syncs, counts and change-feed health; backup progress; recent activity."""
    KEEP = 300

    def __init__(self, acc: Account):
        self.path = status_path(acc.name)
        self.lock = threading.Lock()
        self.changed = threading.Event()
        self.data: dict = {"account": acc.name, "email": acc.email, "local": str(acc.local), "pid": os.getpid(),
                           "started": time.time(), "attention": "", "roots": {}, "backup": None, "activity": []}

    def root(self, name: str, **fields):
        with self.lock:
            self.data["roots"].setdefault(name, {}).update(fields)
        self.changed.set()

    def backup(self, **fields):
        with self.lock:
            self.data["backup"] = {**(self.data["backup"] or {}), **fields}
        self.changed.set()

    def account(self, **fields):
        with self.lock:
            self.data.update(fields)
        self.changed.set()

    def event(self, where: str, kind: str, path: str):
        with self.lock:
            act = self.data["activity"]
            act.append({"t": time.time(), "where": where, "kind": kind, "path": path})
            del act[:-self.KEEP]
        self.changed.set()

    def run(self, stop: threading.Event):
        self.write()
        while not stop.is_set():
            if self.changed.wait(2):
                stop.wait(1)                    # coalesce bursts (e.g. thousands of placeholders)
                self.write()

    def write(self, **final):
        with self.lock:
            self.changed.clear()
            text = json.dumps({**self.data, **final, "updated": time.time()})
        tmp = self.path.with_name(self.path.name + ".tmp")
        try:
            tmp.write_text(text)
            os.replace(tmp, self.path)
        except OSError as e:
            log.debug("cannot write %s: %s", self.path, e)


class _NoBoard:
    """Stand-in when nobody listens (tests, CLI)."""
    def __getattr__(self, _):
        return lambda *a, **k: None


NO_BOARD = _NoBoard()


def file_counts(S: dict) -> dict:
    c = {"local": 0, "cloud": 0, "gdoc": 0, "dir": 0}
    for r in S.values():
        c[r.state] = c.get(r.state, 0) + 1
    return c


# ───────────────────────────── daemon ─────────────────────────────
SYNC_SLOTS = threading.BoundedSemaphore(3)      # syncs at once per process (many sections start together)


class Daemon:
    """Live sync for one account. Local changes arrive through inotify, Drive changes through the
    Changes API. Both become targeted syncs of the affected folders. A full sync runs at start,
    every full_sync_interval (every `interval` when live detection is unavailable), on SIGUSR1,
    and after an inotify queue overflow."""
    QUIET = 2.0             # seconds without new events before a local change is synced

    def __init__(self, acc: Account, changes="auto", board=NO_BOARD):
        self.acc = acc
        self.board = board                      # StatusBoard of the account's process (gdrive-od-ui)
        self.db: DB | None = None               # opened by run(): sqlite objects stay in one thread
        self.eng: Engine | None = None
        self.changes = changes              # DriveChanges | None | "auto"
        self.wake = threading.Event()
        self._stop = threading.Event()
        self.full_requested = True
        self.watcher: Watcher | None = None
        self.deferred: dict[str, float] = {}    # path -> monotonic time to look at it again
        self.token: str | None = None           # Drive changes page token (also kept in the DB)
        self.pending: list[dict] = []           # fetched Drive changes not yet applied
        self.pending_token: str | None = None
        self.root: str | None = None
        self.root_tried = False
        self.feed_fails = 0
        self.feed_retry = 0.0
        self.fails = 0
        self.retry_at = 0.0

    def request_full(self):
        self.full_requested = True
        self.wake.set()

    def stop(self):
        self._stop.set()
        self.wake.set()

    # ── main loop
    def run(self):
        acc = self.acc
        self.db = DB(acc.db_path)
        self._start_watcher()
        if self.changes == "auto":
            self.changes = DriveChanges.for_account(acc)
        log.info("daemon started for %s: local changes %s, Drive changes %s", acc.title,
                 "live (inotify)" if self.watcher else f"every {acc.interval}s",
                 f"every {acc.poll_interval:g}s (Changes API)" if self.changes else f"every {acc.interval}s")
        self.board.root(acc.name, title=acc.title, section=acc.section or "my-drive", local=str(acc.local),
                        state="starting", feed="live" if self.changes else "off",
                        watch="live" if self.watcher else "off")
        next_full = next_poll = 0.0
        try:
            while not self._stop.is_set():
                self.wake.clear()
                now = time.monotonic()
                if self.watcher and self.watcher.take_overflow():
                    log.warning("inotify: event queue overflow or watch lost; running a full sync")
                    self.full_requested = True
                if self.full_requested or now >= next_full:
                    self.full_requested = False
                    ok = self._full_sync()
                    next_full = time.monotonic() + (self._full_period() if ok else acc.interval)
                    next_poll = 0.0
                    self.board.root(acc.name, next_full=time.time() + next_full - time.monotonic())
                else:
                    if self.changes and now >= max(next_poll, self.feed_retry):
                        self._poll()
                        next_poll = time.monotonic() + acc.poll_interval
                    if now >= self.retry_at and not self.full_requested:
                        self._targeted()
                self.wake.wait(self._timeout(next_full, next_poll))
        finally:
            if self.watcher:
                self.watcher.close()
            self.db.close()

    def _timeout(self, next_full: float, next_poll: float) -> float:
        now = time.monotonic()
        if self.full_requested:
            return 0
        t = next_full
        if self.changes:
            t = min(t, max(next_poll, self.feed_retry))
        work = [w for w in (self.watcher.next_ready(self.QUIET) if self.watcher else None,
                            min(self.deferred.values(), default=None),
                            now if self.pending else None) if w is not None]
        if work:
            t = min(t, max(min(work), self.retry_at))
        return min(max(t - now, 0.05), 3600)

    def _full_period(self) -> float:
        live = self.watcher is not None and self.watcher.healthy() and self.changes and self.feed_fails < 3
        return self.acc.full_sync_interval if live else self.acc.interval

    def _start_watcher(self):
        if self.watcher:
            self.watcher.close()
            self.watcher = None
        try:
            self.acc.local.mkdir(parents=True, exist_ok=True)
            self.watcher = Watcher(self.acc.local, self.wake)
            log.info("watching %d folders under %s", len(self.watcher.wd2dir), self.acc.local)
        except OSError as e:
            log.warning("inotify unavailable (%s); local changes are synced every %ss", e, self.acc.interval)

    def _engine(self) -> Engine:
        if self.db.changed() or self.eng is None:   # a CLI pin/unpin/sync changed the DB
            self.eng = Engine(self.acc, self.db)
            self.eng.cancelled = self._stop.is_set
            self.eng.on_event = lambda kind, path: self.board.event(self.acc.title, kind, path)
        return self.eng

    def _synced(self, eng: Engine, full: bool):
        now = time.time()
        self.board.account(attention="")
        self.board.root(self.acc.name, state="idle", error="", last_sync=now, counts=file_counts(eng.S),
                        watch="live" if self.watcher and self.watcher.healthy() else "limited" if self.watcher else "off",
                        **({"last_full": now} if full else {}))

    def _defer(self, d: dict[str, float]):
        for p, left in d.items():
            self.deferred[p] = time.monotonic() + left + 0.2

    def _local_events(self) -> tuple[dict[str, bool], set[str]]:
        """(quiet paths -> writer closed them, logical paths whose events are still arriving)."""
        if not self.watcher:
            return {}, set()
        ready = self.watcher.take(self.QUIET)
        with self.watcher.lock:
            busy = {p[:-len(STUB_EXT)] if p.endswith(STUB_EXT) else p for p in self.watcher.pending}
        return ready, busy

    def _set_token(self, token: str):
        self.token = token
        self.db.set_meta("changes_token", token)
        self.db.set_meta("changes_remote", self.acc.remote)

    def _root(self) -> str | None:
        if not self.root_tried and self.changes:
            self.root_tried = True
            try:
                self.root = self.changes.root_id()
                self.db.set_meta("root_id", self.root)
            except Exception as e:
                log.warning("cannot look up the Drive ID of %s (%s); top-level changes are found by listing",
                            self.acc.remote, e)
        return self.root

    # ── work
    def _full_sync(self) -> bool:
        fresh_token = None
        if self.changes:
            try:
                fresh_token = self.changes.start_token()    # before listing: nothing slips through
                self.feed_fails, self.feed_retry = 0, 0.0    # e.g. right after a reconnect
            except Exception as e:
                self._feed_failed(e)
        if self.watcher is None or not self.watcher.alive:
            self._start_watcher()
        try:
            with SYNC_SLOTS, Locked(self.acc):
                self.board.root(self.acc.name, state="syncing", phase="full")
                eng = self._engine()
                events, busy = self._local_events()     # this sync covers the quiet ones
                eng.sync(fresh={p for p, closed in events.items() if closed}, busy=busy)
                self.deferred = {}
                self._defer(eng.deferred)
                self._synced(eng, full=True)
        except Exception as e:
            self._sync_failed(e)
            return False
        if fresh_token:
            self._set_token(fresh_token)
            self.pending, self.pending_token = [], None
        if self.root is None:
            self.root_tried = False
        self.fails, self.retry_at = 0, 0.0
        return True

    def _poll(self):
        try:
            if self.token is None:          # feed (re)starting: get a token, then reconcile fully
                self._set_token(self.changes.start_token())
                self.full_requested = True
                self.feed_fails = 0
                return
            changes, new_token = self.changes.list_changes(self.pending_token or self.token)
        except TooManyChanges:
            log.info("many Drive changes at once; running a full sync")
            self.full_requested = True
            return
        except ApiError as e:
            if e.code in (400, 404, 410):      # page token rejected: start over
                log.warning("Drive changes: %s; resetting", e)
                self.token, self.pending, self.pending_token = None, [], None
            self._feed_failed(e)
            return
        except Exception as e:
            self._feed_failed(e)
            return
        if self.feed_fails:
            self.board.root(self.acc.name, feed="live", feed_error="")
        self.feed_fails = 0
        self.pending += changes
        self.pending_token = new_token
        if not self.pending:
            if new_token != self.token:
                self._set_token(new_token)
            self.pending_token = None
        elif len(self.pending) > DriveChanges.MAX_CHANGES:      # backlog while syncs kept failing
            log.info("many Drive changes waiting; running a full sync")
            self.full_requested = True

    def _feed_failed(self, e: Exception):
        self.feed_fails += 1
        if isinstance(e, AuthError) or sign_in_expired(e):
            delay = 1800
            if sign_in_expired(e):
                notify_reconnect(self.acc)
            else:
                notify("Google Drive", f"{self.acc.title}: cannot read Drive changes ({e}); "
                                       f"falling back to a full sync every {self.acc.interval}s")
        else:
            delay = min(600, self.acc.poll_interval * 2 ** min(self.feed_fails, 6))
        self.feed_retry = time.monotonic() + delay
        self.board.root(self.acc.name, feed="retrying", feed_error=str(e)[-200:])
        if sign_in_expired(e) or isinstance(e, AuthError):
            self.board.account(attention="sign-in expired")
        (log.warning if self.feed_fails == 1 or isinstance(e, AuthError) else log.debug)(
            "Drive change feed: %s (retry in %ds)", e, delay)

    def _sync_failed(self, e: Exception):
        self.eng = None                         # reload from the DB next time
        self.fails += 1
        self.retry_at = time.monotonic() + min(self.acc.interval, 10 * 2 ** min(self.fails, 5))
        log.error("sync failed: %s", e)
        self.board.root(self.acc.name, state="error", error=str(e)[-300:], error_time=time.time())
        if "Safety stop" in str(e):
            notify("Google Drive — sync paused", str(e))
        elif sign_in_expired(e):
            notify_reconnect(self.acc)
            self.board.account(attention="sign-in expired")

    def _targeted(self):
        acc = self.acc
        now = time.monotonic()
        events, busy = self._local_events()
        for p in [p for p, t in self.deferred.items() if t <= now]:
            del self.deferred[p]
            events.setdefault(p, False)
        if not events and not self.pending:
            return
        dirs: set[str] = set()
        fresh: set[str] = set()
        try:
            with SYNC_SLOTS, Locked(acc):
                eng = self._engine()
                for raw, closed in events.items():
                    p = raw[:-len(STUB_EXT)] if raw.endswith(STUB_EXT) else raw
                    verdict, wait = eng.local_verdict(p, closed)
                    if verdict == "changed":
                        dirs.add(parent(p))
                        if closed:
                            fresh.add(p)
                    elif verdict == "settling":
                        self.deferred[p] = time.monotonic() + wait + 0.2
                n_local = len(dirs)
                if self.pending:
                    dirs |= eng.dirs_for_changes(self.pending, self._root())
                if dirs:
                    self.board.root(acc.name, state="syncing", phase="changes")
                    log.info("changes (%d local, %d Drive) -> syncing %s", len(events), len(self.pending),
                             ", ".join(sorted(d or "/" for d in dirs))[:300])
                    log.debug("%d folder(s) from local events, %d busy path(s)", n_local, len(busy))
                    eng.sync(dirs=dirs, fresh=fresh, busy=busy)
                    self._defer(eng.deferred)
                    self._synced(eng, full=False)
        except ScopeTooBig:
            log.info("many folders changed; running a full sync instead")
            self.full_requested = True
            return
        except Exception as e:
            for raw in events:                  # look at them again after the backoff
                self.deferred.setdefault(raw[:-len(STUB_EXT)] if raw.endswith(STUB_EXT) else raw, 0.0)
            self._sync_failed(e)
            return
        if self.pending_token:
            self._set_token(self.pending_token)
        self.pending, self.pending_token = [], None
        self.fails = 0


# ───────────────────────────── backups ─────────────────────────────
class BackupJob:
    """This PC's folders -> My Drive/Computers/<name>/<folder>: a one-way mirror (rclone sync).
    Changed files become new revisions, removed ones go to the Drive trash. inotify starts a sync
    of just the changed folder within seconds; a full pass runs at start and every
    full_sync_interval. A source that vanished or became empty is never mirrored."""
    QUIET = 5.0
    EXCLUDES = (".~lock.*#", "~$*", "*.part", "*.crdownload", "*.kate-swp", "*.swp", "*.swx", f"*{TMP_EXT}",
                ".Trash-*/**")

    def __init__(self, acc: Account, board=NO_BOARD):
        self.acc = acc
        self.board = board
        self.proc: subprocess.Popen | None = None
        self.title = f"{acc.name} › backup"
        self.host = acc.backup_name or socket.gethostname()
        self.sources = [Path(os.path.realpath(os.path.expanduser(s))) for s in acc.backup]
        self.wake, self._stop = threading.Event(), threading.Event()
        self.full_requested = True
        self.watchers: dict[Path, Watcher] = {}
        self.state_path = STATE_DIR / f"{acc.name}.backup.json"
        try:
            self.counts: dict[str, int] = json.loads(self.state_path.read_text())   # files per source
        except (OSError, ValueError):
            self.counts = {}

    def request_full(self):
        self.full_requested = True
        self.wake.set()

    def stop(self):
        self._stop.set()
        self.wake.set()
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()

    def paused(self) -> bool:
        return backup_pause_flag(self.acc.name).exists()

    def publish(self, **fields):
        self.board.backup(sources=[{"path": str(s), "files": self.counts.get(str(s)),
                                    "dest": f"My Drive/{BACKUP_ROOT}/{self.host}/{s.name}"} for s in self.sources],
                          **fields)

    def dest(self, src: Path, rel: str = "") -> str:
        base = f"{BACKUP_ROOT}/{self.host}/{src.name}"
        return self.acc.rpath(join(base, rel) if rel else base)

    def run(self):
        for src in self.sources:
            if src.is_dir():
                try:
                    self.watchers[src] = Watcher(src, self.wake)
                except OSError as e:
                    log.warning("backup: cannot watch %s (%s); it is backed up every %ss", src, e,
                                self.acc.full_sync_interval)
        log.info("backup of %s to %s", ", ".join(map(str, self.sources)), self.dest(Path("…")).rsplit("/", 1)[0])
        self.publish(state="paused" if self.paused() else "starting", progress=None)
        next_full = 0.0
        try:
            while not self._stop.is_set():
                self.wake.clear()
                if any(w.take_overflow() for w in self.watchers.values()):
                    self.full_requested = True
                if self.paused():                        # changes keep queueing in the watchers
                    self.publish(state="paused", progress=None)
                    self.wake.wait(3600)
                    continue
                if self.full_requested or time.monotonic() >= next_full:
                    self.full_requested = False
                    ok = all([self.sync(src, "", True) for src in self.sources])
                    next_full = time.monotonic() + (self.acc.full_sync_interval if ok else self.acc.interval)
                    if ok:
                        self.publish(state="idle", progress=None, last_full=time.time(),
                                     next_full=time.time() + next_full - time.monotonic())
                else:
                    for src, w in self.watchers.items():
                        for rel, recursive in self.targets(src, w.take_entries(self.QUIET)):
                            if self._stop.is_set():
                                break
                            self.sync(src, rel, recursive)
                due = [t for t in (w.next_ready(self.QUIET) for w in self.watchers.values()) if t is not None]
                self.wake.wait(0 if self.full_requested else
                               min(max(min([next_full, *due]) - time.monotonic(), 0.05), 3600))
        finally:
            for w in self.watchers.values():
                w.close()

    @staticmethod
    def targets(src: Path, events: dict[str, tuple[bool, bool]]) -> list[tuple[str, bool]]:
        """What to mirror for these changed paths: a changed file -> its folder (one level); a new
        folder -> that folder (whole); something deleted -> its folder (whole if it was a folder)."""
        out: set[tuple[str, bool]] = set()
        for rel, (_, was_dir) in events.items():
            fp = src / rel
            if fp.is_dir() and not fp.is_symlink():
                out.add((rel, True))
            elif fp.exists() or fp.is_symlink():
                out.add((parent(rel), False))
            else:
                out.add((parent(rel), was_dir))
        deep = {r for r, d in out if d}
        return sorted((r, d) for r, d in out
                      if not any(x != r and under(r, x) for x in deep) and (d or r not in deep))

    def sync(self, src: Path, rel: str, recursive: bool) -> bool:
        if not src.is_dir():
            notify("Google Drive — backup paused", f"{src} is missing; its backup in Drive is left as it is.")
            self.publish(state="error", error=f"{src} is missing", error_time=time.time())
            return False
        if not rel:                                     # full pass: guard against a vanished/empty source
            n = sum(len(files) for _, _, files in os.walk(src))
            if n == 0 and self.counts.get(str(src), 0) > 0:
                notify("Google Drive — backup paused", f"{src} is empty now; its backup in Drive is left as it is.")
                self.publish(state="error", error=f"{src} is empty", error_time=time.time())
                return False
            self.counts[str(src)] = n
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            self.state_path.write_text(json.dumps(self.counts))
        while rel and not (src / rel).is_dir():          # deleted folder: mirror the closest one left
            rel, recursive = parent(rel), True
        cap = max(25, self.counts.get(str(src), 0) // 2)
        args = [RCLONE, "sync", str(src / rel) if rel else str(src), self.dest(src, rel),
                "--max-delete", str(cap), "--skip-links", "-v", "--use-json-log", "--stats", "2s",
                *(["--fast-list", "--track-renames"] if recursive else ["--max-depth", "1"]),
                *(a for x in self.EXCLUDES for a in ("--exclude", x)), *BASE_FLAGS, *self.acc.rclone_args]
        t = time.monotonic()
        where = f"{src.name}/{rel}" if rel else src.name
        new = upd = gone = moved = 0
        errors: list[str] = []
        self.publish(state="running", current=where, progress=None)
        self.proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                                     stdin=subprocess.DEVNULL)
        for line in self.proc.stderr:
            try:
                d = json.loads(line)
            except ValueError:
                errors.append(line.strip())
                continue
            if "stats" in d:
                st = d["stats"]
                self.publish(state="running", current=where, progress={
                    k: st.get(k) for k in ("bytes", "totalBytes", "transfers", "totalTransfers", "checks",
                                           "totalChecks", "speed", "eta", "errors", "deletes")})
            msg, obj = d.get("msg", ""), d.get("object") or ""
            kind = ("new" if msg.startswith("Copied (new)") else "updated" if msg.startswith("Copied (") else
                    "moved" if msg.startswith("Moved") else "removed" if msg.startswith("Deleted") else "")
            if kind:
                new, upd, moved, gone = new + (kind == "new"), upd + (kind == "updated"), \
                    moved + (kind == "moved"), gone + (kind == "removed")
                self.board.event(self.title, f"backup: {kind}", join(where, obj) if obj else where)
            elif d.get("level") in ("error", "critical"):
                errors.append(msg)
            if self.paused() or self._stop.is_set():          # stop now; the next run picks up from here
                self.proc.terminate()
        rc = self.proc.wait()
        if self.paused() or self._stop.is_set():
            self.publish(state="paused" if self.paused() else "stopped", progress=None)
            return False
        if rc:
            err = " / ".join(errors)[-400:] or f"rclone exited with {rc}"
            if "max-delete" in err.lower() or "max delete" in err.lower():
                notify("Google Drive — backup paused", f"Backing up {where} would delete more than {cap} files "
                                                       "in Drive; nothing was deleted. Check the folder.")
            elif sign_in_expired(RuntimeError(err)):
                notify_reconnect(self.acc)
                self.board.account(attention="sign-in expired")
            log.error("backup of %s failed: %s", where, err)
            self.publish(state="error", error=err, error_time=time.time(), progress=None)
            return False
        if new or upd or gone or moved or not rel:
            log.info("backup of %s: %d new, %d updated, %d moved, %d removed (%.0fs)",
                     where, new, upd, moved, gone, time.monotonic() - t)
        self.publish(state="idle", error="", current="", progress=None, last_run=time.time())
        return True


