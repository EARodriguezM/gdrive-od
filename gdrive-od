# ───────────────────────────── config ─────────────────────────────
@dataclass
class Account:
    name: str
    remote: str
    local: Path
    email: str = ""
    browser: list = field(default_factory=lambda: ["xdg-open"])
    interval: int = 120                 # full-sync period when live change detection is unavailable
    settle: int = 10
    max_delete_pct: int = 50
    rclone_args: list = field(default_factory=list)
    poll_interval: float = 15           # Drive Changes API polling period
    full_sync_interval: int = 1800      # safety-net full sync when live change detection works
    sections: bool = False              # My Drive / Shared with me / Shared drives / Computers in `local`
    shared_with_me: bool = True         # (sections) show "Shared with me"
    shared_drives: object = "all"       # (sections) "all", a list of drive names, or [] for none
    backup: list = field(default_factory=list)   # this PC's folders -> My Drive/Computers/<backup_name>/
    backup_name: str = ""               # defaults to the host name
    # set on the sync roots derived from a sections account (see sync_roots)
    section: str = ""                   # "" plain account | my-drive | shared | drive
    owner: str = ""                     # the [accounts.NAME] this root belongs to
    label: str = ""                     # human-readable name for logs and notifications
    ref: str = ""                       # Shared drive ID (section "drive")
    exclude: list = field(default_factory=list)  # top-level paths left out (My Drive/Computers if backups)

    @property
    def title(self) -> str:
        return self.label or self.name

    def rpath(self, rel: str = "") -> str:
        if not rel:
            return self.remote
        sep = "" if self.remote.endswith((":", "/")) else "/"
        return self.remote + sep + rel

    @property
    def db_path(self) -> Path:
        return STATE_DIR / f"{self.name}.db"

    @property
    def lock_path(self) -> Path:
        return STATE_DIR / f"{self.name}.lock"


def die(msg: str, code: int = 1):
    log.error(msg)
    notify("Google Drive", msg)
    sys.exit(code)


def load_config(required: bool = True) -> dict[str, Account]:
    if not CONFIG_PATH.exists():
        if not required:
            return {}
        die(f"No config at {CONFIG_PATH}. Add an account with 'gdrive-od add-account NAME --email ...'.")
    data = tomllib.loads(CONFIG_PATH.read_text())
    accs = {}
    for name, a in data.get("accounts", {}).items():
        accs[name] = Account(
            name=name, remote=a["remote"],
            local=Path(os.path.realpath(os.path.expanduser(a["local"]))),
            email=a.get("email", ""), browser=list(a.get("browser", ["xdg-open"])),
            interval=int(a.get("interval", 120)), settle=int(a.get("settle", 10)),
            max_delete_pct=int(a.get("max_delete_pct", 50)),
            rclone_args=list(a.get("rclone_args", [])),
            poll_interval=float(a.get("poll_interval", 15)),
            full_sync_interval=int(a.get("full_sync_interval", 1800)),
            sections=bool(a.get("sections", False)), shared_with_me=bool(a.get("shared_with_me", True)),
            shared_drives=a.get("shared_drives", "all"), backup=list(a.get("backup", [])),
            backup_name=str(a.get("backup_name", "")))
    if not accs and required:
        die(f"No accounts in {CONFIG_PATH}. Add one with 'gdrive-od add-account NAME --email ...'.")
    return accs


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)        # a valid TOML basic string
    if isinstance(v, (list, tuple)):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    raise TypeError(f"cannot write {v!r} to TOML")


def config_set(account: str, key: str, value=None):
    """Set `key` in [accounts.<account>] of the config (None removes it). Every other line,
    comments included, stays as it is; a result that doesn't parse is never written."""
    lines = CONFIG_PATH.read_text().splitlines()
    header = re.compile(r"^\s*\[\s*accounts\s*\.\s*" + re.escape(account) + r"\s*\]\s*(#.*)?$")
    start = next((i for i, line in enumerate(lines) if header.match(line)), None)
    if start is None:
        raise KeyError(f"no [accounts.{account}] in {CONFIG_PATH}")
    end = next((i for i in range(start + 1, len(lines)) if re.match(r"^\s*\[[^\]]*\]\s*(#.*)?$", lines[i])
                and not re.match(r"^\s*\[\s*[\"'\d-]", lines[i])), len(lines))
    found = None
    for i in range(start + 1, end):
        if re.match(r"^\s*" + re.escape(key) + r"\s*=", lines[i]):
            j, depth = i, lines[i].split("#")[0].count("[") - lines[i].split("#")[0].count("]")
            while depth > 0 and j + 1 < end:                # a multi-line array
                j += 1
                depth += lines[j].split("#")[0].count("[") - lines[j].split("#")[0].count("]")
            found = (i, j)
            break
    new = [] if value is None else [f"{key} = {toml_value(value)}"]
    if found:
        lines[found[0]:found[1] + 1] = new
    elif new:
        k = end
        while k > start + 1 and not lines[k - 1].strip():
            k -= 1
        lines[k:k] = new
    text = "\n".join(lines) + "\n"
    parsed = tomllib.loads(text).get("accounts", {}).get(account, {})
    if parsed.get(key) != value:
        raise ValueError(f"config edit of {account}.{key} did not round-trip")
    tmp = CONFIG_PATH.with_name(CONFIG_PATH.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, CONFIG_PATH)


# ───────────────────────────── sections ─────────────────────────────
# With `sections = true` an account folder looks like the Drive website. Each section except
# Computers is its own sync root with its own DB, lock and change feed; My Drive keeps the
# account's original DB. Computers: Google lets only its "Drive for desktop" app create entries
# there, so this PC's backups go to My Drive/Computers/<name>/ (left out of the My Drive sync) and
# the local Computers folder holds links to the backed-up folders.
MY_DRIVE, SHARED, DRIVES, COMPUTERS = "My Drive", "Shared with me", "Shared drives", "Computers"
SECTION_ICONS = {MY_DRIVE: "folder-gdrive", SHARED: "folder-publicshare", DRIVES: "folder-network",
                 COMPUTERS: "computer"}
BACKUP_ROOT = "Computers"


def drives_cache(acc: Account) -> Path:
    return STATE_DIR / f"{acc.name}.drives.json"


def refresh_shared_drives(acc: Account) -> list[dict]:
    """The account's Shared drives ([{id, name}] from `rclone backend drives`), cached so that
    Dolphin actions resolve paths without the network."""
    try:
        drives = [{"id": d["id"], "name": d["name"]}
                  for d in json.loads(rclone(acc, "backend", "drives", acc.remote) or "[]")]
    except (RuntimeError, ValueError, KeyError) as e:
        log.warning("%s: cannot list Shared drives (%s); using the last known list", acc.name, e)
        return cached_shared_drives(acc)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    drives_cache(acc).write_text(json.dumps(drives))
    return drives


def cached_shared_drives(acc: Account) -> list[dict]:
    try:
        return json.loads(drives_cache(acc).read_text())
    except (OSError, ValueError):
        return []


def sync_roots(acc: Account, refresh: bool = False) -> list[Account]:
    """The sync roots of an account: itself, or with sections My Drive, Shared with me and one root
    per Shared drive."""
    if not acc.sections:
        return [acc]
    name = split_remote(acc.remote)[0]
    roots = [replace(acc, local=acc.local / MY_DRIVE, section="my-drive", owner=acc.name,
                     label=f"{acc.name} › {MY_DRIVE}", exclude=[BACKUP_ROOT] if acc.backup else [])]
    if not name:                    # sections need a real rclone remote
        return roots
    if acc.shared_with_me:
        roots.append(replace(acc, name=f"{acc.name}.shared", remote=f"{name},shared_with_me=true:",
                             local=acc.local / SHARED, section="shared", owner=acc.name,
                             label=f"{acc.name} › {SHARED}", backup=[]))
    if acc.shared_drives:
        wanted = None if acc.shared_drives == "all" else {str(w).strip() for w in acc.shared_drives}
        used: set[str] = set()
        for d in refresh_shared_drives(acc) if refresh else cached_shared_drives(acc):
            title = d["name"].strip()
            if wanted is not None and title not in wanted:
                continue
            folder = title.replace("/", "∕") or "Unnamed drive"
            n = 2
            while folder.casefold() in used:
                folder = f"{title.replace('/', '∕')} ({n})"
                n += 1
            used.add(folder.casefold())
            roots.append(replace(acc, name=f"{acc.name}.drive-{d['id']}", remote=f"{name},team_drive={d['id']}:",
                                 local=acc.local / DRIVES / folder, section="drive", owner=acc.name,
                                 label=f"{acc.name} › {title}", ref=d["id"], backup=[]))
    return roots


def all_roots(accs: dict[str, Account]) -> list[Account]:
    """Every sync root, deepest folder first (so a Shared drive wins over its account folder)."""
    return sorted((r for a in accs.values() for r in sync_roots(a)), key=lambda r: -len(r.local.parts))


def migrate_to_sections(acc: Account):
    """The v0.2 layout synced My Drive straight into `local`; with sections it lives in
    `local`/My Drive. Two renames, nothing re-downloaded (paths in the DB are relative)."""
    md, tmp = acc.local / MY_DRIVE, acc.local.with_name(acc.local.name + ".gdod-migrating")
    with Locked(acc):
        if tmp.exists() and not md.exists():                 # interrupted half way
            acc.local.mkdir(parents=True, exist_ok=True)
            os.rename(tmp, md)
        elif not md.exists() and acc.local.is_dir() and acc.db_path.exists() and any(acc.local.iterdir()):
            os.rename(acc.local, tmp)
            acc.local.mkdir()
            os.rename(tmp, md)
        else:
            return
    log.info("%s: moved the synced My Drive into %s", acc.name, md)


def prepare_layout(acc: Account):
    """Section folders with their icons, and Computers/<this PC>/<folder> links to backed-up folders."""
    if not acc.sections:
        return
    migrate_to_sections(acc)          # first: an empty "My Drive" made here would block the move
    named = bool(split_remote(acc.remote)[0])        # Shared with me / Shared drives need an rclone remote
    for sec, icon in SECTION_ICONS.items():
        if sec == MY_DRIVE and not (acc.local / MY_DRIVE).is_dir() or sec == COMPUTERS and not acc.backup \
                or sec == DRIVES and not (named and acc.shared_drives) \
                or sec == SHARED and not (named and acc.shared_with_me):
            continue                  # My Drive's folder is created by its first sync
        set_folder_icon(acc.local / sec, icon)
    set_folder_icon(acc.local, "folder-gdrive")
    if acc.backup:
        pc = acc.local / COMPUTERS / (acc.backup_name or socket.gethostname())
        set_folder_icon(pc, "computer-laptop")
        for src in acc.backup:
            src = Path(os.path.realpath(os.path.expanduser(src)))
            link = pc / src.name
            if link.is_symlink() and Path(os.readlink(link)) != src:
                link.unlink()
            if not link.exists() and not link.is_symlink():
                link.symlink_to(src, target_is_directory=True)


# ───────────────────────────── helpers ─────────────────────────────
_notified: dict[tuple, float] = {}


def notify(summary: str, body: str = ""):
    now = time.monotonic()
    if now - _notified.get((summary, body), -1e9) < 600:      # the daemon repeats itself; don't spam
        return
    _notified[(summary, body)] = now
    if shutil.which("notify-send") and os.environ.get("GDOD_NO_NOTIFY") is None:
        subprocess.Popen(["notify-send", "-a", "Google Drive", "-i", "folder-cloud", summary, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def human(n: int) -> str:
    f = float(max(n, 0))
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if f < 1024 or unit == "TB":
            return f"{f:.0f} {unit}" if unit == "B" else f"{f:.1f} {unit}"
        f /= 1024
    return f"{n} B"


def parse_time(s: str):
    try:
        s = s.replace("Z", "+00:00")
        if "." in s:
            head, rest = s.split(".", 1)
            i = 0
            while i < len(rest) and rest[i].isdigit():
                i += 1
            frac, tz = rest[:i][:6], rest[i:]
            s = f"{head}.{frac}{tz}" if frac else head + tz
        return dt.datetime.fromisoformat(s).timestamp()
    except Exception:
        return None


def ignored_name(n: str) -> bool:
    return n in IGNORE_NAMES or n.startswith(IGNORE_PREFIX) or n.endswith(IGNORE_SUFFIX)


def join(a: str, b: str) -> str:
    return f"{a}/{b}" if a else b


def parent(p: str) -> str:
    return p.rsplit("/", 1)[0] if "/" in p else ""


def under(p: str, prefix: str) -> bool:
    return prefix == "" or p == prefix or p.startswith(prefix + "/")


def lstat_or_none(fp: Path):
    try:
        return fp.lstat()
    except OSError:
        return None


def rekey(m: dict, old: str, new: str):
    """Move every entry (S rows or R items) at or below `old` to the same place below `new`."""
    for k in [k for k in m if under(k, old)]:
        v = m.pop(k)
        nk = new + k[len(old):]
        rn = new + v.rname[len(old):] if under(v.rname, old) else v.rname
        m[nk] = replace(v, path=nk, rname=rn)


def getx(fp: Path, key: str) -> str:
    try:
        return os.getxattr(fp, key).decode()
    except OSError:
        return ""


def setx(fp: Path, key: str, val: str):
    try:
        os.setxattr(fp, key, val.encode())
    except OSError:
        pass


def set_status_tag(fp: Path, tag: str):
    """Dolphin shows user.xdg.tags in its 'Tags' column. Keep the user's own tags."""
    cur = [t for t in getx(fp, "user.xdg.tags").split(",") if t]
    new = [t for t in cur if t not in OUR_TAGS] + [tag]
    if new != cur:
        setx(fp, "user.xdg.tags", ",".join(new))


def md5_file(fp: Path) -> str:
    h = hashlib.md5()
    with open(fp, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def trash_local(fp: Path, acc: Account):
    if shutil.which("gio") and subprocess.run(["gio", "trash", str(fp)],
                                              capture_output=True).returncode == 0:
        return
    if shutil.which("kioclient") and subprocess.run(["kioclient", "move", str(fp), "trash:/"],
                                                    capture_output=True).returncode == 0:
        return
    dest = STATE_DIR / "trash" / acc.name / dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    dest.mkdir(parents=True, exist_ok=True)
    shutil.move(str(fp), dest / fp.name)


class RcloneError(RuntimeError):
    def __init__(self, msg: str, code: int):
        super().__init__(msg)
        self.code = code


def rclone(acc: Account, *args: str) -> str:
    cmd = [RCLONE, *args, *BASE_FLAGS, *acc.rclone_args]
    log.debug("run: %s", " ".join(cmd))
    p = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if p.returncode != 0:
        raise RcloneError(f"rclone {args[0]} failed: {p.stderr.strip()[-600:]}", p.returncode)
    return p.stdout


class Locked:
    """One sync/pin/unpin at a time per account (daemon and Dolphin actions share it)."""
    def __init__(self, acc: Account):
        self.acc = acc

    def __enter__(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.f = open(self.acc.lock_path, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


