def link_url(data: dict) -> str:
    """URL to open for a Google file link (.gdoc/.gsheet/...): the editor for known types."""
    if data.get("type") in EDITOR_URL and data.get("id"):
        return EDITOR_URL[data["type"]].format(urllib.parse.quote(data["id"]))
    return data["url"]


def cmd_open(accs, args):
    fp = Path(args.path)
    acc, rel = resolve(accs, args.path)
    if fp.name.endswith(STUB_EXT):
        with Locked(acc):
            db = DB(acc.db_path)
            eng = Engine(acc, db)
            try:
                eng.hydrate(rel)
            except Exception as e:
                log.error("%s", e)
                die(f"Could not download {fp.name[:-len(STUB_EXT)]} — are you online?")
            db.save(eng.S)
        xdg_open(acc.local / rel)
    elif fp.suffix in LINK_EXTS:
        data = json.loads(fp.read_text())
        open_browser(accs.get(data.get("account"), acc), link_url(data))
    else:
        xdg_open(fp)


SECTION_URLS = {MY_DRIVE: "https://drive.google.com/drive/my-drive",
                SHARED: "https://drive.google.com/drive/shared-with-me",
                DRIVES: "https://drive.google.com/drive/shared-drives",
