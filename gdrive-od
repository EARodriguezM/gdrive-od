def mime_xml() -> str:
    kinds = []
    for ext, (mime, comment, icon, _, _) in sorted(GFILE_KINDS.items()):
        parent = "" if mime == "application/x-gdrive-gfile" else \
            '\n    <sub-class-of type="application/x-gdrive-gfile"/>'
        kinds.append(f"""  <mime-type type="{mime}">
    <comment>{comment}</comment>{parent}
    <icon name="{icon}"/>
    <generic-icon name="text-html"/>
    <glob pattern="*{ext}"/>
  </mime-type>
""")
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-gdrive-placeholder">
    <comment>Google Drive file (online only)</comment>
    <icon name="folder-cloud"/>
    <glob pattern="*{STUB_EXT}"/>
  </mime-type>
{''.join(kinds)}</mime-info>
"""


def set_folder_icon(folder: Path, icon: str):
    """Dolphin folder icon via the folder's .directory file (ignored by the sync); keeps its other keys."""
    folder.mkdir(parents=True, exist_ok=True)
    f = folder / ".directory"
    lines = f.read_text().splitlines() if f.exists() else []
    out, in_entry, done = [], False, False
    for line in lines:
        if line.startswith("["):
            if in_entry and not done:
                out.append(f"Icon={icon}")
                done = True
            in_entry = line.strip() == "[Desktop Entry]"
        elif in_entry and line.startswith("Icon="):
            line, done = f"Icon={icon}", True
        out.append(line)
    if in_entry and not done:
        out.append(f"Icon={icon}")
    elif not done:
        out += ([""] if out else []) + ["[Desktop Entry]", f"Icon={icon}"]
    f.write_text("\n".join(out) + "\n")


def add_places(data: Path, accs: dict[str, Account]) -> list[str]:
    """Dolphin's Places panel (user-places.xbel): one 'Google Drive · <folder>' entry per account,
    appended after the user's own places. Existing entries for the same folder are left alone."""
    xbel = data / "user-places.xbel"
    if not xbel.exists():
        return []
    text = xbel.read_text()
    added, entries = [], ""
    for i, acc in enumerate(accs.values()):
        href = escape(acc.local.as_uri(), {'"': "&quot;"})
        if f'href="{href}"' in text:
            continue
        title = escape(f"Google Drive · {acc.local.name}")
        entries += f""" <bookmark href="{href}">
  <title>{title}</title>
  <info>
   <metadata owner="http://freedesktop.org">
    <bookmark:icon name="{FOLDER_ICON}"/>
   </metadata>
   <metadata owner="http://www.kde.org">
    <ID>{int(time.time())}/gdrive-od-{i}</ID>
   </metadata>
  </info>
 </bookmark>
"""
        added.append(acc.local.name)
    if entries:
        cut = text.rfind("</bookmark>")
        cut = cut + len("</bookmark>\n") if cut >= 0 else text.rfind("</xbel>")
        backup = xbel.with_name(xbel.name + ".gdrive-od.bak")
        if not backup.exists():
            shutil.copy2(xbel, backup)
        tmp = xbel.with_name(xbel.name + ".gdod-tmp")
        tmp.write_text(text[:cut] + entries + text[cut:])
        os.replace(tmp, xbel)
    return added


