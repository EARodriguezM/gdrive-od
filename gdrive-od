"""
    for path, content in files.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print(f"wrote {path}")
    (data / "kio/servicemenus/gdrive-od.desktop").chmod(0o755)   # KF6 requires +x
    icons = data / "icons/hicolor/scalable/mimetypes"            # fallbacks for themes without them
    icons.mkdir(parents=True, exist_ok=True)
    for _, _, icon, colour, glyph in GFILE_KINDS.values():
        (icons / f"{icon}.svg").write_text(GFILE_ICON_SVG.format(colour=colour, glyph=glyph))
    print(f"wrote Google file icons to {icons}")
    if not CONFIG_PATH.exists():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(CONFIG_HEADER)
        print(f"wrote {CONFIG_PATH}")
    for acc in accs.values():                                    # Drive icon on the account folders
        if acc.sections:
            prepare_layout(acc)                                  # migrates a flat My Drive first
        else:
            set_folder_icon(acc.local, FOLDER_ICON)
        if acc.local.parent != HOME:
            set_folder_icon(acc.local.parent, FOLDER_ICON)
    if added := add_places(data, accs):
        print(f"added to Dolphin's Places panel: {', '.join('Google Drive · ' + a for a in added)}")
    for cmd in (["update-mime-database", str(data / "mime")],
                ["update-desktop-database", str(data / "applications")],
                *(["xdg-mime", "default", "gdrive-od-open.desktop", m]
                  for m in ["application/x-gdrive-placeholder", *gfile_mimes]),
                ["kbuildsycoca6"], ["kbuildsycoca5"], ["systemctl", "--user", "daemon-reload"]):
        if shutil.which(cmd[0]):
            subprocess.run(cmd, capture_output=True)
