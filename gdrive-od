def cmd_web(accs, args):
    owner = account_of(accs, args.path)
    ap = Path(os.path.realpath(args.path))
    if owner and owner.sections and (ap == owner.local or ap.parent == owner.local or COMPUTERS in ap.parts):
        part = ap.relative_to(owner.local).parts[:1]           # the account folder or a section folder
        return open_browser(owner, SECTION_URLS.get(part[0] if part else MY_DRIVE, SECTION_URLS[MY_DRIVE]))
    acc, rel = resolve(accs, args.path)
    row = DB(acc.db_path).load().get(rel)
    if rel == "":
        url = {"shared": SECTION_URLS[SHARED],
               "drive": f"https://drive.google.com/drive/folders/{acc.ref}"}.get(acc.section, SECTION_URLS[MY_DRIVE])
    elif not row or not row.rid:
        die("This item has not been synced to Drive yet.")
    elif row.kind == "dir":
        url = f"https://drive.google.com/drive/folders/{row.rid}"
    elif row.kind == "gdoc":
        url = f"https://drive.google.com/open?id={row.rid}"
    else:
        url = f"https://drive.google.com/file/d/{row.rid}/view"
    open_browser(acc, url)


def cmd_status(accs, args):
    for p in args.paths:
        owner = account_of(accs, p)
        if owner and owner.sections and Path(os.path.realpath(p)) in (owner.local, owner.local / DRIVES):
            for root in sync_roots(owner):                       # the account folder: every section
                if Path(os.path.realpath(p)) in root.local.parents:
                    S = DB(root.db_path).load()
                    cnt = {k: sum(1 for r in S.values() if r.state == k) for k in ("local", "cloud", "gdoc")}
                    print(f"{root.title}: {cnt['local']} offline, {cnt['cloud']} online-only, "
                          f"{cnt['gdoc']} Google files")
            continue
        acc, rel = resolve(accs, p)
        db = DB(acc.db_path)
        S, pins = db.load(), db.pins()
        if rel == "" or (acc.local / rel).is_dir():
            sub = [r for r in S.values() if under(r.path, rel) and r.kind != "dir"]
            cnt = {k: sum(1 for r in sub if r.state == k) for k in ("local", "cloud", "gdoc")}
            pinned = any(under(rel, x) for x in pins)
            print(f"{p}: {cnt['local']} offline, {cnt['cloud']} online-only, {cnt['gdoc']} Google files"
                  f"{'  [always keep offline]' if pinned else ''}")
        else:
            row = S.get(rel)
            print(f"{p}: {({'local': 'offline', 'cloud': 'online only', 'gdoc': 'Google file'}).get(row.state) if row else 'not synced yet'}")


