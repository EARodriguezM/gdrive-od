def resolve(accs: dict[str, Account], path: str) -> tuple[Account, str]:
    """The sync root a path belongs to (a section of an account, or the account) and the path in it."""
    ap = Path(os.path.realpath(path))
    for root in all_roots(accs):
        try:
            rel = str(ap.relative_to(root.local))
        except ValueError:
            continue
        rel = "" if rel == "." else rel
        if rel.endswith(STUB_EXT):
            rel = rel[:-len(STUB_EXT)]
        return root, rel
    die(f"{path} is not inside a synced Google Drive folder")


def account_of(accs: dict[str, Account], path: str) -> Account | None:
    """The configured account whose folder contains `path` (also its section folders)."""
    ap = Path(os.path.realpath(path))
    return next((a for a in accs.values() if ap == a.local or a.local in ap.parents), None)


def open_browser(acc: Account, url: str):
    if acc.email:
        url += ("&" if "?" in url else "?") + "authuser=" + acc.email
    subprocess.Popen([*acc.browser, url], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def xdg_open(fp: Path):
    subprocess.Popen(["xdg-open", str(fp)], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_sync(accs, args):
    failed = []
    for n in args.accounts or list(accs):
        acc = accs.get(n) or die(f"unknown account {n}")
        prepare_layout(acc)
        for root in sync_roots(acc, refresh=True):
            try:
                with Locked(root):
                    Engine(root, DB(root.db_path)).sync(force=args.force)
            except Exception as e:
                log.error("%s: %s", root.title, e)
                failed.append(root.title)
    if failed:
        die(f"sync failed for {', '.join(failed)}")


def google_sign_in(acc: Account, client: list[str]) -> str:
    """`rclone authorize drive [ID SECRET]`, its consent page opened in the account's browser
    (profile); returns the token JSON once the user approved (dies after 10 minutes)."""
    p = subprocess.Popen([RCLONE, "authorize", "drive", *client, "--auth-no-open-browser",
                          *BASE_FLAGS, *acc.rclone_args],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, stdin=subprocess.DEVNULL)
    timer = threading.Timer(600, p.kill)                # nobody approved within 10 minutes
    timer.start()
    out, opened = [], False
    for line in p.stdout:
        out.append(line)
        m = re.search(r"(http://127\.0\.0\.1:\d+/auth\?state=\S+)", line)
        if m and not opened:
            opened = True
            subprocess.Popen([*acc.browser, m.group(1)], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"{acc.name}: approve access for {acc.email or acc.remote} in the browser window that opened\n"
                  f"  (if nothing opened, visit {m.group(1)} in the browser where that account is signed in)")
            notify("Google Drive", f"Approve access for {acc.email or acc.name} in the browser window that opened")
    p.wait()
    timer.cancel()
    m = re.search(r"--->\s*(\{.*?\})\s*<---End paste", "".join(out), re.S)
    if p.returncode or not m:
        die(f"{acc.name}: sign-in did not complete (no approval within 10 minutes, or it was refused)")
    return m.group(1)


def default_client() -> Path:
    return CONFIG_PATH.with_name("oauth-client.json")


# Chromium-family browsers: their "Local State" lists the profiles and the Google account in each.
BROWSERS = (("google-chrome", ("google-chrome-stable", "google-chrome")),
            ("google-chrome-beta", ("google-chrome-beta",)),
            ("chromium", ("chromium", "chromium-browser")),
            ("BraveSoftware/Brave-Browser", ("brave", "brave-browser")),
            ("microsoft-edge", ("microsoft-edge-stable", "microsoft-edge")),
            ("vivaldi", ("vivaldi-stable", "vivaldi")))


def browser_for(email: str, config_home: Path | None = None) -> list[str]:
    """The command that opens URLs in the browser profile where `email` is signed in, else the
    default browser."""
    config_home = config_home or Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
    for folder, exes in BROWSERS:
        exe = next((shutil.which(e) for e in exes if shutil.which(e)), None)
        try:
            profiles = json.loads((config_home / folder / "Local State").read_text())["profile"]["info_cache"]
        except (OSError, ValueError, KeyError):
            continue
        for directory, info in profiles.items():
            if exe and email and info.get("user_name", "").casefold() == email.casefold():
                return [exe, f"--profile-directory={directory}"]
    return ["xdg-open"]


def read_client(path: Path) -> tuple[str, str]:
    """client_id and client_secret of a Google OAuth "Desktop app" client (its downloaded JSON)."""
    try:
        c = json.loads(path.read_text())
        c = c.get("installed") or c.get("web") or c
        return c["client_id"], c["client_secret"]
    except (OSError, ValueError, KeyError):
        die(f"No usable OAuth client at {path}. Create a 'Desktop app' client in Google Cloud and "
            "download its JSON (see docs/google-oauth-client.md), then pass it with --client FILE.")


def home_relative(p: Path) -> str:
    return "~/" + str(p.relative_to(HOME)) if HOME in p.parents else str(p)


def config_add_account(acc: Account):
    """Append an [accounts.NAME] block to the config (created if needed); other lines untouched."""
    block = [f"[accounts.{acc.name}]", f"remote   = {toml_value(acc.remote)}",
             f"local    = {toml_value(home_relative(acc.local))}", f"email    = {toml_value(acc.email)}",
             f"browser  = {toml_value(acc.browser)}"]
    if acc.sections:
        block.append("sections = true")
    if acc.backup:
        block.append(f"backup   = {toml_value(acc.backup)}")
    text = CONFIG_PATH.read_text() if CONFIG_PATH.exists() else CONFIG_HEADER
    text = text.rstrip("\n") + "\n\n" + "\n".join(block) + "\n"
    if acc.name not in tomllib.loads(text).get("accounts", {}):
        raise ValueError("config edit failed")
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_name(CONFIG_PATH.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, CONFIG_PATH)


def cmd_add_account(accs, args):
    """Connect a Google account: rclone remote signed in with your own OAuth client (consent page
    in the browser profile of that account), [accounts.NAME] in the config, desktop integration,
    first sync (placeholders only) and the systemd service."""
    name = args.name
    if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
        die("Account names may contain letters, digits, '-' and '_' only.")
    if name in accs:
        die(f"There already is an account '{name}' in {CONFIG_PATH}.")
    email = args.email or input(f"Google account (email) for '{name}': ").strip()
    keep = default_client()
    client_file = Path(os.path.expanduser(args.client)) if args.client else keep
    cid, secret = read_client(client_file)
    if client_file.resolve() != keep.resolve() and not keep.exists():
        keep.parent.mkdir(parents=True, exist_ok=True)                 # kept for the next accounts
        shutil.copyfile(client_file, keep)
        keep.chmod(0o600)
    remote = args.remote or f"gdrive-{name}"
    local = Path(os.path.realpath(os.path.expanduser(args.local or f"~/GoogleDrive/{name[:1].upper()}{name[1:]}")))
    browser = args.browser.split() if args.browser else browser_for(email)
    acc = Account(name=name, remote=f"{remote}:", local=local, email=email, browser=browser,
                  sections=not args.flat, backup=[home_relative(Path(os.path.realpath(os.path.expanduser(b))))
                                                  for b in args.backup or []])
    if any(a.local == local or a.local in local.parents or local in a.local.parents for a in accs.values()):
        die(f"{local} overlaps the folder of another account.")
    existing = json.loads(rclone(acc, "config", "dump") or "{}")
    if remote in existing and not args.reuse_remote:
        die(f"An rclone remote '{remote}' already exists: pick another name with --remote, "
            "or use it as is with --reuse-remote.")
    print(f"Account '{name}' ({email}) -> {local}\n  browser: {' '.join(browser)}")
    if remote not in existing:
        token = google_sign_in(acc, [cid, secret])
        rclone(acc, "config", "create", remote, "drive", f"client_id={cid}", f"client_secret={secret}",
               "scope=drive", f"token={token}", "--non-interactive")
    try:
        about = json.loads(rclone(acc, "about", "--json", acc.remote) or "{}")
        print(f"  connected: {human(about.get('used', 0))} used in Google Drive")
    except (RuntimeError, ValueError) as e:
        die(f"The rclone remote '{remote}' was created but Google Drive can't be read ({e}). Is the Google "
            "Drive API enabled in your Cloud project, and is this account a test user of the app?")
    config_add_account(acc)
    print(f"  added [accounts.{name}] to {CONFIG_PATH}")
    data = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    if acc.sections:
        prepare_layout(acc)
    else:
        set_folder_icon(acc.local, FOLDER_ICON)
    add_places(data, {name: acc})
    if not args.no_sync:
        print("  first sync (placeholders only, nothing is downloaded)…")
        cmd_sync({name: acc}, argparse.Namespace(accounts=[name], force=False))
    if not args.no_service and shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        ok = subprocess.run(["systemctl", "--user", "enable", "--now", f"gdrive-od@{name}"],
                            capture_output=True).returncode == 0
        print(f"  {'started' if ok else 'could not start'} the service gdrive-od@{name}")
    print(f"Done. Your files are in {acc.local}.")


def cmd_reconnect(accs, args):
    """Sign an account in to Google again (expired or revoked token): `rclone authorize` with the
    remote's own OAuth client, consent page opened in that account's browser profile, new token
    stored in the rclone remote, running daemon told to sync."""
    targets: list[Account] = []
    for a in args.targets or list(accs):
        acc = accs.get(a) or (account_of(accs, a) if os.path.exists(a) else None) or die(f"unknown account {a}")
        if acc not in targets:
            targets.append(acc)
    for acc in targets:
        name, _ = split_remote(acc.remote)
        base = name.split(",")[0]
        params = (json.loads(rclone(acc, "config", "dump")).get(base) or {}) if name else {}
        if params.get("type") != "drive":
            die(f"{acc.name}: {acc.remote} is not a Google Drive rclone remote")
        client = [params["client_id"], params["client_secret"]] \
            if params.get("client_id") and params.get("client_secret") else []
        token = google_sign_in(acc, client)
        rclone(acc, "config", "update", base, f"token={token}", "--non-interactive")
        log.info("%s: reconnected", acc.name)
        notify("Google Drive", f"{acc.name} is connected again")
        unit = f"gdrive-od@{acc.name}"
        if shutil.which("systemctl") and subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit]).returncode == 0:
            subprocess.run(["systemctl", "--user", "reload", unit], capture_output=True)   # SIGUSR1: sync now


def daemon_pid(name: str) -> int | None:
    """PID of the running daemon of account `name` (from its status file), if it is alive."""
    try:
        data = json.loads(status_path(name).read_text())
        pid = int(data["pid"])
        if data.get("stopped"):
            return None
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except (OSError, ValueError, KeyError):
        return None
    return pid if b"daemon" in cmdline and name.encode() in cmdline else None


def signal_daemon(name: str, sig: int) -> bool:
    pid = daemon_pid(name)
    if pid:
        os.kill(pid, sig)
    return pid is not None


def cmd_backup(accs, args):
    """gdrive-od backup pause|resume|now [ACCOUNT...]"""
    for acc in [accs.get(a) or die(f"unknown account {a}") for a in args.accounts] or \
               [a for a in accs.values() if a.backup]:
        flag = backup_pause_flag(acc.name)
        if args.action == "pause":
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            flag.touch()
        elif args.action == "resume":
            flag.unlink(missing_ok=True)
        running = signal_daemon(acc.name, signal.SIGUSR2 if args.action != "now" else signal.SIGUSR1)
        print(f"{acc.name}: backup {args.action}{'' if running else ' (the sync service is not running)'}")


def cmd_daemon(accs, args):
    """One process per account: a Daemon thread per sync root (My Drive, Shared with me, each
    Shared drive) and the backup job. SIGUSR1 = full sync of everything; Shared drives you join
    later are picked up hourly and on SIGUSR1."""
    acc = accs.get(args.account) or die(f"unknown account {args.account}")
    prepare_layout(acc)
    board = StatusBoard(acc)
    workers: dict[str, object] = {}
    threads: list[threading.Thread] = []

    def start(key: str, w):
        workers[key] = w
        t = threading.Thread(target=w.run, name=w.title if isinstance(w, BackupJob) else w.acc.title, daemon=True)
        t.start()
        threads.append(t)

    for root in sync_roots(acc, refresh=True):
        start(root.name, Daemon(root, board=board))
    if acc.backup:
        start("backup", BackupJob(acc, board=board))
    stop, refresh = threading.Event(), threading.Event()
    threading.Thread(target=board.run, args=(stop,), name="status", daemon=True).start()

    def on_usr1(*_):
        refresh.set()
        for w in workers.values():
            w.request_full()

    def on_usr2(*_):                    # backup paused/resumed (gdrive-od backup pause|resume)
        job = workers.get("backup")
        if job:
            job.wake.set() if job.paused() else job.request_full()

    signal.signal(signal.SIGUSR1, on_usr1)
    signal.signal(signal.SIGUSR2, on_usr2)
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    next_refresh = time.monotonic() + 3600
    try:
        while not stop.is_set() and any(t.is_alive() for t in threads):
            stop.wait(1)
            if acc.sections and acc.shared_drives and (refresh.is_set() or time.monotonic() > next_refresh):
                refresh.clear()
                next_refresh = time.monotonic() + 3600
                for root in sync_roots(acc, refresh=True):
                    if root.name not in workers:
                        log.info("new Shared drive: %s", root.title)
                        start(root.name, Daemon(root, board=board))
    except KeyboardInterrupt:
        pass
    stop.set()
    for w in workers.values():
        w.stop()
    for t in threads:
        t.join(60)
    board.write(stopped=time.time())
    log.info("daemon stopped for %s", acc.name)


def _group(accs, paths):
    out: dict[str, tuple[Account, list[str]]] = {}
    for p in paths:
        acc, rel = resolve(accs, p)
        out.setdefault(acc.name, (acc, []))[1].append(rel)
    return out.values()


def cmd_pin(accs, args):
    for acc, rels in _group(accs, args.paths):
        with Locked(acc):
            db = DB(acc.db_path)
            eng = Engine(acc, db)
            targets = []
            for rel in rels:
                if rel == "" or eng.real_path(rel).is_dir():
                    db.add_pin(rel)
                    targets += [q for q, r in eng.S.items() if r.state == "cloud" and under(q, rel)]
                elif rel in eng.S:
                    targets.append(rel)
            if len(targets) > 3:
                notify("Google Drive", f"Downloading {len(targets)} files…")
            done = 0
            for q in targets:
                try:
                    eng.hydrate(q)
                    done += 1
                except Exception as e:
                    log.error("%s", e)
                    notify("Google Drive", f"Could not download {os.path.basename(q)} (offline?)")
            db.save(eng.S)
            if len(targets) > 3:
                notify("Google Drive", f"{done} files are now available offline")


def cmd_unpin(accs, args):
    for acc, rels in _group(accs, args.paths):
        with Locked(acc):
            db = DB(acc.db_path)
            eng = Engine(acc, db)
            freed = 0
            for rel in rels:
                if rel == "" or eng.real_path(rel).is_dir():
                    db.remove_pins_under(rel)
                    eng.pins = db.pins()
                    targets = [q for q, r in eng.S.items() if r.state == "local" and under(q, rel)]
                else:
                    targets = [rel]
                if eng.pinned(rel):
                    notify("Google Drive", f"'{os.path.basename(rel) or acc.name}' is inside a folder set to "
                                           "'always keep offline'; it will be downloaded again.")
                for q in targets:
                    try:
                        freed += eng.dehydrate(q)
                    except Exception as e:
                        log.error("%s", e)
            db.save(eng.S)
            if freed:
                notify("Google Drive", f"Freed space: {freed} file(s) are now online-only")


