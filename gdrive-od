def main():
    ap = argparse.ArgumentParser(prog="gdrive-od", description="Google Drive on-demand sync (rclone based)")
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("--version", action="version", version=VERSION)
    sp = ap.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("sync"); s.add_argument("accounts", nargs="*"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_sync)
    s = sp.add_parser("daemon"); s.add_argument("account"); s.set_defaults(fn=cmd_daemon)
    for name, fn in (("pin", cmd_pin), ("unpin", cmd_unpin), ("status", cmd_status)):
        s = sp.add_parser(name); s.add_argument("paths", nargs="+"); s.set_defaults(fn=fn)
    for name, fn in (("open", cmd_open), ("web", cmd_web)):
        s = sp.add_parser(name); s.add_argument("path"); s.set_defaults(fn=fn)
    s = sp.add_parser("add-account", help="connect a Google account (sign-in, config, first sync, service)")
    s.add_argument("name", help="short name, e.g. personal or work")
    s.add_argument("--email", help="the Google account (also picks the browser profile)")
    s.add_argument("--client", help="OAuth client JSON (default: oauth-client.json next to the config)")
    s.add_argument("--local", help="folder for this account (default ~/GoogleDrive/Name)")
    s.add_argument("--remote", help="rclone remote name (default gdrive-NAME)")
    s.add_argument("--browser", help="command that opens Google Docs, e.g. 'firefox -P work'")
    s.add_argument("--backup", action="append", metavar="FOLDER", help="back up this folder of this computer")
    s.add_argument("--flat", action="store_true", help="only My Drive, without the section folders")
    s.add_argument("--reuse-remote", action="store_true", help="use an existing rclone remote as it is")
    s.add_argument("--no-sync", action="store_true", help="don't run the first sync now")
    s.add_argument("--no-service", action="store_true", help="don't enable the systemd service")
    s.set_defaults(fn=cmd_add_account)
    s = sp.add_parser("backup"); s.add_argument("action", choices=["pause", "resume", "now"])
    s.add_argument("accounts", nargs="*"); s.set_defaults(fn=cmd_backup)
    s = sp.add_parser("reconnect"); s.add_argument("targets", nargs="*", metavar="ACCOUNT_OR_PATH")
    s.set_defaults(fn=cmd_reconnect)
    s = sp.add_parser("setup-desktop"); s.set_defaults(fn=cmd_setup_desktop)
    args = ap.parse_args()
    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(asctime)s %(levelname)s %(message)s", datefmt="%H:%M:%S")
    accs = load_config(required=args.cmd not in ("setup-desktop", "add-account"))
    args.fn(accs, args)


