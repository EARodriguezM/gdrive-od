class MainWindow(QMainWindow):
    def __init__(self, model: Model):
        super().__init__()
        self.model = model
        self.setWindowTitle("Google Drive")
        self.setWindowIcon(QIcon.fromTheme("folder-gdrive"))
        self.tabs = QTabWidget()
        self.accounts = AccountsTab(model)
        self.backup = BackupTab(model)
        self.activity = ActivityTab(model)
        self.settings = SettingsTab(model)
        self.tabs.addTab(self.accounts, QIcon.fromTheme("folder-gdrive"), "Accounts")
        self.tabs.addTab(self.backup, QIcon.fromTheme("computer"), "Backup")
        self.tabs.addTab(self.activity, QIcon.fromTheme("view-history", QIcon.fromTheme("document-open-recent")), "Activity")
        self.tabs.addTab(self.settings, QIcon.fromTheme("configure"), "Settings")
        self.setCentralWidget(self.tabs)
        self.resize(920, 560)
        self.quit_on_close = False

    def refresh(self):
        self.accounts.refresh()
        self.backup.refresh()
        self.activity.refresh()
        self.settings.refresh()

    def closeEvent(self, ev):
        if self.quit_on_close:
            QApplication.quit()
        ev.accept()


class App:
    def __init__(self, show_window: bool):
        self.model = Model()
        self.model.refresh()
        self.win = MainWindow(self.model)
        self.tray = None
        if QSystemTrayIcon.isSystemTrayAvailable():
            self.tray = QSystemTrayIcon()
            self.tray.activated.connect(self.on_tray)
            self.menu = QMenu()
            self.tray.setContextMenu(self.menu)
            self.tray.show()
        else:
            self.win.quit_on_close = True
            show_window = True
        self.watcher = QFileSystemWatcher()
        core.STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.watcher.addPath(str(core.STATE_DIR))
        self.watcher.directoryChanged.connect(lambda *_: self.refresh())
        self.timer = QTimer()
        self.timer.timeout.connect(self.refresh)
        self.timer.start(2000)
        self.refresh()
        if show_window:
            self.show_window()

    def refresh(self):
        self.model.refresh()
        state = self.model.overall()
        if self.tray:
            self.tray.setIcon(state_icon(state))
            self.tray.setToolTip("Google Drive\n" + self.model.summary())
            self.build_menu()
        self.win.setWindowIcon(state_icon(state))
        if self.win.isVisible():
            self.win.refresh()

    def build_menu(self):
        m = self.menu
        m.clear()
        m.addAction(QIcon.fromTheme("folder-gdrive"), "Open Google Drive status", self.show_window)
        m.addSeparator()
        for name, acc in self.model.accounts.items():
            sub = m.addMenu(dot(STATE_COLOURS[self.model.account_state(name)]), f"{name} — {acc.email or acc.remote}")
            sub.addAction(QIcon.fromTheme("folder-open"), "Open folder", lambda a=acc: open_path(str(a.local)))
            sub.addAction(QIcon.fromTheme("view-refresh"), "Sync now", lambda n=name: sync_now(n, self.model))
            if acc.backup:
                paused = core.backup_pause_flag(name).exists()
                sub.addAction(QIcon.fromTheme("media-playback-start" if paused else "media-playback-pause"),
                              "Resume backup" if paused else "Pause backup",
                              lambda n=name, p=paused: run_tool("backup", "resume" if p else "pause", n))
            if self.model.account_state(name) == "attention":
                sub.addAction(QIcon.fromTheme("dialog-password"), "Reconnect…", lambda n=name: run_tool("reconnect", n))
        m.addSeparator()
        quit_action = QAction(QIcon.fromTheme("application-exit"), "Quit (syncing continues)", m)
        quit_action.triggered.connect(QApplication.quit)
        m.addAction(quit_action)

    def on_tray(self, reason):
        if reason in (QSystemTrayIcon.Trigger, QSystemTrayIcon.DoubleClick):
            if self.win.isVisible() and self.win.isActiveWindow():
                self.win.hide()
            else:
                self.show_window()

    def show_window(self):
        self.win.refresh()
        self.win.show()
        self.win.raise_()
        self.win.activateWindow()


def main():
    global core
    core = load_core()
    app = QApplication(sys.argv)
    app.setApplicationName(APP_ID)
    app.setApplicationDisplayName("Google Drive")
    app.setDesktopFileName(APP_ID)
    app.setQuitOnLastWindowClosed(False)
    sock = QLocalSocket()                       # one instance: a second launch just shows the window
    sock.connectToServer(APP_ID)
    if sock.waitForConnected(300):
        sock.write(b"show")
        sock.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(APP_ID)
    server = QLocalServer()
    server.listen(APP_ID)
    ui = App(show_window="--tray" not in sys.argv)
    server.newConnection.connect(lambda: (server.nextPendingConnection(), ui.show_window()))
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
