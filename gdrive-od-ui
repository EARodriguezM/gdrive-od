def load_core():
    """Import the gdrive-od script next to this file (or on PATH) as a module."""
    for cand in (Path(__file__).resolve().parent / "gdrive-od", Path(shutil.which("gdrive-od") or "/nonexistent")):
        if cand.is_file():
            loader = importlib.machinery.SourceFileLoader("gdod", str(cand))
            spec = importlib.util.spec_from_loader("gdod", loader)
            mod = importlib.util.module_from_spec(spec)
            sys.modules["gdod"] = mod
            loader.exec_module(mod)
            return mod
    sys.exit("gdrive-od-ui: cannot find the gdrive-od script")


# ───────────────────────────── formatting ─────────────────────────────
def ago(t) -> str:
    if not t:
        return "never"
    d = time.time() - t
    if d < 60:
        return "just now"
    if d < 3600:
        return f"{int(d // 60)} min ago"
    if d < 86400:
        return f"{int(d // 3600)} h ago"
    return time.strftime("%d %b %H:%M", time.localtime(t))


def duration(s) -> str:
    if s is None:
        return "?"
    s = int(s)
    if s < 60:
        return f"{s} s"
    if s < 3600:
        return f"{s // 60} min"
    return f"{s // 3600} h {s % 3600 // 60:02d} min"


def human(n) -> str:
    return core.human(int(n or 0))


# ───────────────────────────── model ─────────────────────────────
class Model:
    """Accounts from the config + what their daemons publish."""

    def __init__(self):
        self.accounts: dict = {}
        self.status: dict[str, dict | None] = {}
        self.alive: dict[str, bool] = {}
        self.config_error = ""

    def refresh(self):
        try:
            self.accounts = core.load_config() if core.CONFIG_PATH.exists() else {}
            self.config_error = "" if self.accounts else f"No accounts configured in {core.CONFIG_PATH}"
        except SystemExit:
            self.config_error = f"Cannot read {core.CONFIG_PATH}"
        except Exception as e:                              # a TOML typo, for instance
            self.config_error = f"{core.CONFIG_PATH}: {e}"
        for name in self.accounts:
            try:
                self.status[name] = json.loads(core.status_path(name).read_text())
            except (OSError, ValueError):
                self.status[name] = None
            # a service started by an older gdrive-od publishes no status: ask systemd
            self.alive[name] = core.daemon_pid(name) is not None or \
                systemctl("is-active", "--quiet", unit(name), wait=True) == 0

    def account_state(self, name: str) -> str:
        st = self.status.get(name)
        if not self.alive.get(name):
            return "stopped"
        if not st or not core.daemon_pid(name):
            return "syncing"                                # running, no details (yet)
        if st.get("attention"):
            return "attention"
        roots = list((st.get("roots") or {}).values())
        backup = st.get("backup") or {}
        if any(r.get("state") == "error" for r in roots) or backup.get("state") == "error":
            return "error"
        if any(r.get("state") in ("syncing", "starting") for r in roots) or backup.get("state") in ("running", "starting"):
            return "syncing"
        return "ok"

    def overall(self) -> str:
        states = [self.account_state(n) for n in self.accounts]
        for s in ("error", "attention", "stopped", "syncing"):
            if s in states:
                return s
        return "ok" if states else "stopped"

    def summary(self) -> str:
        if self.config_error:
            return self.config_error
        lines = []
        for name in self.accounts:
            state = self.account_state(name)
            st = self.status.get(name) or {}
            text = {"ok": "up to date", "syncing": "syncing…", "error": "has errors", "stopped": "not running",
                    "attention": "sign in again (Reconnect)"}[state]
            b = st.get("backup") or {}
            if self.alive.get(name) and b.get("state") == "running" and b.get("progress"):
                text += f" · backup {backup_percent(b['progress'])}%"
            elif self.alive.get(name) and b.get("state") == "paused":
                text += " · backup paused"
            lines.append(f"{name}: {text}")
        return "\n".join(lines)

    def roots(self, name: str) -> list[dict]:
        """Sections of an account: as published by its daemon, else as configured."""
        st = self.status.get(name) or {}
        published = (st.get("roots") or {}) if self.alive.get(name) else {}
        return [{**published.get(r.name, {}), "name": r.name, "section": r.section or "my-drive",
                 "local": str(r.local), "title": r.label.split(" › ", 1)[-1] if r.label else core.MY_DRIVE}
                for r in core.sync_roots(self.accounts[name])]


def backup_percent(p: dict) -> int:
    total = p.get("totalBytes") or 0
    if total:
        return min(100, int(100 * (p.get("bytes") or 0) / total))
    tt = p.get("totalTransfers") or 0
    return min(100, int(100 * (p.get("transfers") or 0) / tt)) if tt else 0


def backup_text(b: dict | None, alive: bool) -> str:
    if not alive:
        return "The sync service is not running."
    if not b:
        return "Starting…"
    state = b.get("state")
    p = b.get("progress") or {}
    if state == "running" and p:
        parts = [f"Backing up {b.get('current') or ''}".rstrip()]
        if p.get("totalTransfers"):
            parts.append(f"{p.get('transfers', 0):,} of {p['totalTransfers']:,} files")
        if p.get("totalBytes"):
            parts.append(f"{human(p.get('bytes'))} of {human(p['totalBytes'])}")
        if p.get("speed"):
            parts.append(f"{human(p['speed'])}/s")
        if p.get("eta"):
            parts.append(f"{duration(p['eta'])} left")
        elif p.get("totalChecks") and not p.get("totalTransfers"):
            parts.append(f"comparing {p.get('checks', 0):,} of {p['totalChecks']:,} files")
        return " · ".join(parts)
    if state == "running":
        return f"Backing up {b.get('current') or ''}… (listing files)"
    if state == "paused":
        return "Paused. Changes are remembered and backed up when you resume."
    if state == "error":
        return f"Problem: {b.get('error') or 'unknown error'} ({ago(b.get('error_time'))})"
    text = "Up to date"
    if b.get("last_full"):
        text += f" · last full check {ago(b['last_full'])}"
    if b.get("next_full"):
        text += f" · next in {duration(max(0, b['next_full'] - time.time()))}"
    return text


def root_status(r: dict, alive: bool) -> tuple[str, str]:
    """(text, colour) for a section row."""
    if not alive:
        return "Not running", STATE_COLOURS["stopped"]
    state = r.get("state")
    if state == "error":
        err = (r.get("error") or "").replace("rclone ", "").strip()
        return f"Error: {err[:60] + '…' if len(err) > 60 else err}", STATE_COLOURS["error"]
    if state == "syncing":
        return ("Checking everything…" if r.get("phase") == "full" else "Syncing changes…"), STATE_COLOURS["syncing"]
    if state in (None, "starting"):
        return "Starting…", STATE_COLOURS["syncing"]
    return "Up to date", STATE_COLOURS["ok"]


# ───────────────────────────── icons ─────────────────────────────
def state_icon(state: str, size: int = 64) -> QIcon:
    """The Drive folder icon with a small state badge (✓ ↻ ! ■)."""
    base = QIcon.fromTheme("folder-gdrive", QIcon.fromTheme("folder-cloud", QIcon.fromTheme("folder")))
    pm = base.pixmap(size, size) if not base.isNull() else QPixmap(size, size)
    if base.isNull():
        pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    r = size * 0.42
    box = QRectF(size - r - 1, size - r - 1, r, r)
    p.setPen(Qt.NoPen)
    p.setBrush(QColor(STATE_COLOURS[state]))
    p.drawEllipse(box)
    pen = QPen(QColor("white"), max(2.0, size / 16))
    pen.setCapStyle(Qt.RoundCap)
    p.setPen(pen)
    c, k = box.center(), r / 4.2
    if state == "ok":
        p.drawPolyline([QPointF(c.x() - k, c.y()), QPointF(c.x() - k / 3, c.y() + k * 0.8), QPointF(c.x() + k, c.y() - k * 0.7)])
    elif state == "syncing":
        p.drawArc(QRectF(c.x() - k, c.y() - k, 2 * k, 2 * k), 30 * 16, 280 * 16)
    elif state in ("attention", "error"):
        p.drawLine(QPointF(c.x(), c.y() - k), QPointF(c.x(), c.y() + k * 0.25))
        p.drawPoint(QPointF(c.x(), c.y() + k * 0.85))
    else:
        p.drawLine(QPointF(c.x() - k * 0.7, c.y()), QPointF(c.x() + k * 0.7, c.y()))
    p.end()
    return QIcon(pm)


def dot(colour: str) -> QIcon:
    pm = QPixmap(12, 12)
    pm.fill(Qt.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.Antialiasing)
    p.setPen(Qt.NoPen)
    p.setBrush(QColor(colour))
    p.drawEllipse(1, 1, 10, 10)
    p.end()
    return QIcon(pm)


# ───────────────────────────── actions ─────────────────────────────
def run_tool(*args: str):
    """Run a gdrive-od command in the background (it reports problems through notifications)."""
    subprocess.Popen([sys.executable, core.__file__, *args], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def systemctl(*args: str, wait: bool = False) -> int:
    if not shutil.which("systemctl"):
        return 1
    cmd = ["systemctl", "--user", *args]
    if wait:
        return subprocess.run(cmd, capture_output=True).returncode
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


def unit(name: str) -> str:
    return f"gdrive-od@{name}"


def sync_now(name: str, model: Model):
    if not core.signal_daemon(name, signal.SIGUSR1):        # not running: start it (it syncs at start)
        systemctl("start", unit(name))


def apply_config(name: str):
    """Settings take effect when the account's service restarts (it finishes the current step first)."""
    if systemctl("is-active", "--quiet", unit(name), wait=True) == 0:
        systemctl("restart", unit(name))


def open_path(path: str):
    subprocess.Popen(["xdg-open", path], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


